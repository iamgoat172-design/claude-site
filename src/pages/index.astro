---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Catalog from "../components/Catalog.astro";
import Footer from "../components/Footer.astro";

// РЕДИЗАЙН (на согласование направления): показываем только ядро —
// Hero + каталог в новой подаче. Остальные секции (Доверие, Что входит,
// Этапы, Стоимость, Построенные, Отзывы, Бюро, География, Форма) будут
// переработаны в этом же языке после подтверждения direction.
---

<Base>
  <Header />
  <main>
    <Hero />
    <Catalog />
  </main>
  <Footer />
</Base>
