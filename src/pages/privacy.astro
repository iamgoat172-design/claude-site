---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";

// Политика конфиденциальности (152-ФЗ «О персональных данных»).
// Контакты совпадают с макетом. Реквизиты юрлица (наименование, ИНН/ОГРН)
// — заглушки в квадратных скобках: заказчик подставит реальные перед
// продакшеном (как и фото — см. HANDOFF §6).
const updated = "23 июня 2026";

const sections = [
  {
    n: "01",
    title: "Общие положения",
    body: [
      "Настоящая Политика конфиденциальности (далее — «Политика») определяет порядок обработки и защиты персональных данных пользователей сайта (далее — «Сайт») и составлена в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ «О персональных данных».",
      "Оставляя данные через форму заявки на Сайте, пользователь подтверждает согласие с условиями настоящей Политики и даёт согласие на обработку своих персональных данных на изложенных ниже условиях.",
    ],
  },
  {
    n: "02",
    title: "Оператор персональных данных",
    body: [
      "Оператором, организующим и осуществляющим обработку персональных данных, является [полное наименование организации / ИП], ИНН [ИНН], ОГРН [ОГРН/ОГРНИП] (далее — «Оператор»).",
      "Адрес: Москва, Дмитровское шоссе, 81. Телефон: 8 (499) 113-57-63. Электронная почта: forestvologda@gmail.com.",
    ],
  },
  {
    n: "03",
    title: "Какие данные мы обрабатываем",
    body: [
      "Через форму заявки на Сайте Оператор обрабатывает данные, которые пользователь предоставляет добровольно: имя, номер телефона, ник в Telegram (по желанию), а также сведения о предполагаемом проекте — материал и площадь дома.",
      "Дополнительно при посещении Сайта могут автоматически собираться обезличенные технические данные (cookie, IP-адрес, сведения о браузере и устройстве, источник перехода) — для аналитики и корректной работы Сайта.",
    ],
  },
  {
    n: "04",
    title: "Цели обработки",
    body: [
      "Персональные данные обрабатываются для обработки и уточнения заявки, консультирования по проектам и условиям строительства, подготовки коммерческого предложения и связи с пользователем по оставленному запросу.",
      "Обезличенные технические данные используются для анализа поведения посетителей и улучшения Сайта.",
    ],
  },
  {
    n: "05",
    title: "Правовое основание",
    body: [
      "Обработка персональных данных осуществляется на основании согласия субъекта персональных данных, выраженного при отправке формы заявки, а также положений 152-ФЗ и иных нормативных актов РФ в области персональных данных.",
    ],
  },
  {
    n: "06",
    title: "Порядок и сроки обработки",
    body: [
      "Обработка осуществляется с использованием средств автоматизации и без таковых: сбор, запись, систематизация, хранение, уточнение, использование, передача (предоставление, доступ), блокирование, удаление и уничтожение.",
      "Персональные данные хранятся не дольше, чем этого требуют цели обработки, и подлежат уничтожению по достижении целей либо при отзыве согласия, если иное не предусмотрено законодательством РФ.",
    ],
  },
  {
    n: "07",
    title: "Передача третьим лицам",
    body: [
      "Оператор не продаёт и не передаёт персональные данные третьим лицам для целей, не связанных с обработкой заявки. Данные могут передаваться поставщикам сервисов (CRM, телефония, аналитика), привлечённым для исполнения указанных выше целей, при условии соблюдения ими требований по защите персональных данных.",
      "Передача данных в государственные органы осуществляется только по основаниям и в порядке, предусмотренном законодательством РФ.",
    ],
  },
  {
    n: "08",
    title: "Права пользователя",
    body: [
      "Пользователь вправе получать сведения об обработке своих персональных данных, требовать их уточнения, блокирования или уничтожения в случае, если данные являются неполными, устаревшими, неточными, незаконно полученными или не являются необходимыми для целей обработки.",
      "Согласие на обработку может быть отозвано в любой момент путём направления обращения на электронную почту forestvologda@gmail.com.",
    ],
  },
  {
    n: "09",
    title: "Файлы cookie и аналитика",
    body: [
      "Сайт может использовать файлы cookie и системы веб-аналитики для корректной работы и оценки эффективности. Пользователь может отключить cookie в настройках браузера; при этом отдельные функции Сайта могут работать некорректно.",
    ],
  },
  {
    n: "10",
    title: "Изменения Политики",
    body: [
      "Оператор вправе вносить изменения в настоящую Политику. Актуальная редакция всегда размещена на этой странице. Дата последнего обновления указана ниже.",
    ],
  },
];
---

<Base
  title="Политика конфиденциальности — Вологодское Зодчество"
  description="Политика обработки персональных данных сайта премиум-линейки домов «Вологодское Зодчество» в соответствии с 152-ФЗ."
>
  <main class="min-h-screen bg-ink">
    <!-- Лёгкая шапка страницы: знак + возврат на главную -->
    <header class="border-b border-white/10">
      <div
        class="mx-auto flex max-w-[820px] items-center justify-between gap-4 px-5 py-5 sm:px-8"
      >
        <a href="/" class="group flex items-center gap-2.5">
          <span
            class="h-1.5 w-1.5 rounded-full bg-accent transition-transform duration-500 group-hover:scale-150"
          ></span>
          <span
            class="text-[13px] font-semibold uppercase tracking-[0.22em] text-on-ink"
          >
            Вологодское&nbsp;Зодчество
          </span>
        </a>
        <a
          href="/"
          class="text-[13px] text-on-ink/65 transition-colors hover:text-accent"
        >
          ← На главную
        </a>
      </div>
    </header>

    <article class="mx-auto max-w-[820px] px-5 py-16 sm:px-8 sm:py-24">
      <p class="eyebrow text-accent-soft">Правовая информация</p>
      <h1 class="display-lg mt-5 text-on-ink">
        Политика<br />конфиденциальности
      </h1>
      <div class="rule-accent mt-8 w-24"></div>
      <p class="mt-6 max-w-prose text-[15px] leading-relaxed text-on-ink/60">
        Обработка персональных данных пользователей сайта в соответствии с
        Федеральным законом № 152-ФЗ «О персональных данных».
      </p>

      <div class="mt-14 space-y-12">
        {
          sections.map((s) => (
            <section class="rise">
              <div class="flex items-baseline gap-4">
                <span class="tnum font-[var(--font-display)] text-sm text-accent/70">
                  {s.n}
                </span>
                <h2 class="font-[var(--font-display)] text-xl text-on-ink sm:text-2xl">
                  {s.title}
                </h2>
              </div>
              <div class="mt-4 space-y-4 pl-0 sm:pl-10">
                {s.body.map((p) => (
                  <p class="text-[15px] leading-relaxed text-on-ink/70">{p}</p>
                ))}
              </div>
            </section>
          ))
        }
      </div>

      <!-- Контакты для обращений -->
      <section class="rise glass hairline-top mt-16 rounded-[24px] p-7 sm:p-9">
        <h2 class="font-[var(--font-display)] text-xl text-on-ink">
          Контакты для обращений
        </h2>
        <p class="mt-3 text-[15px] leading-relaxed text-on-ink/70">
          По вопросам обработки персональных данных, а также для отзыва согласия
          обращайтесь к Оператору:
        </p>
        <ul class="mt-5 space-y-2 text-[15px] text-on-ink/80">
          <li>
            Телефон:
            <a
              href="tel:+74991135763"
              class="text-accent-soft transition-colors hover:text-accent"
              >8 (499) 113-57-63</a
            >
          </li>
          <li>
            Эл. почта:
            <a
              href="mailto:forestvologda@gmail.com"
              class="text-accent-soft transition-colors hover:text-accent"
              >forestvologda@gmail.com</a
            >
          </li>
          <li>Адрес: Москва, Дмитровское шоссе, 81</li>
        </ul>
        <p class="mt-6 text-sm text-on-ink/45">
          Дата обновления: {updated}.
        </p>
      </section>
    </article>
  </main>
  <Footer />
</Base>
