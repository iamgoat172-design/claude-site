---
import { HERO_IMAGE } from "../data/projects";

const proof = [
  ["25", "лет на рынке"],
  ["1500+", "домов сдано"],
  ["Свой лес", "Вологодский и Архангельский северный лес"],
  ["Договор", "и гарантия 25 лет"],
];
---

<section
  id="hero"
  class="grain vignette relative flex min-h-dvh flex-col overflow-hidden bg-ink"
>
  <!-- Фон-фото с лёгким параллаксом -->
  <div class="absolute inset-0 scale-[1.12]" data-parallax>
    <img
      src={HERO_IMAGE}
      alt="Дом из клееного бруса с тёплым светом в окнах зимним вечером в сосновом лесу"
      class="h-full w-full object-cover"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div
    class="absolute inset-0 z-[2] bg-gradient-to-t from-ink via-ink/35 to-ink/10"
  >
  </div>

  <!-- Контент прижат к низу -->
  <div
    class="relative z-[3] mt-auto w-full px-5 pb-12 sm:px-8 sm:pb-16 lg:px-12 lg:pb-20"
  >
    <div class="mx-auto flex max-w-[1400px] flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <!-- Тезис -->
      <div class="max-w-3xl">
        <a
          href="https://xn--b1aaceafbozh6abbccd6bht1h.xn--p1ai/"
          target="_blank"
          rel="noopener"
          class="reveal group inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.06] px-4 py-2 text-xs text-on-ink/85 backdrop-blur-md transition-colors hover:border-accent/50"
        >
          <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-accent/15 text-accent-soft">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l7 4v5c0 4.5-3 8.5-7 9.5-4-1-7-5-7-9.5V7l7-4z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span>Проект компании <span class="font-semibold text-on-ink">«Вологодское&nbsp;Зодчество»</span> · производитель бруса с 1998 года</span>
          <svg class="h-3 w-3 shrink-0 text-on-ink/40 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <p class="eyebrow reveal reveal-1 mt-5 text-accent-soft">
          Дома от 250 м²
        </p>
        <h1 class="display-xl mt-5 text-on-ink">
          <span class="block reveal reveal-2">Большие дома</span>
          <span class="block reveal reveal-3">из дерева</span>
          <span class="block reveal reveal-4">
            и <span class="underline-draw text-accent-soft">камня.</span>
          </span>
        </h1>

        <div class="reveal reveal-5 mt-8 flex flex-col gap-6 sm:flex-row sm:items-center">
          <p class="max-w-md text-[15px] leading-relaxed text-on-ink/75 sm:text-base">
            Сами производим клееный брус с 1998 года. Строим большие дома под
            ключ в Московской и Ленинградской областях — со своего леса и
            производства, по договору с фиксированной сметой.
          </p>
          <div class="flex shrink-0 items-center gap-3">
            <a
              href="#lead"
              data-quiz="smeta"
              class="group inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03]"
            >
              Получить расчёт
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <a
              href="#catalog"
              class="text-sm font-medium text-on-ink/80 underline-offset-4 transition-colors hover:text-accent hover:underline"
            >
              Смотреть проекты
            </a>
          </div>
        </div>
      </div>

      <!-- Типографский индекс-доказательство (не плашки) -->
      <dl
        class="reveal reveal-5 hidden w-full max-w-xs shrink-0 border-t border-white/15 lg:block"
      >
        {
          proof.map(([big, small], i) => (
            <div
              class={`flex items-baseline justify-between gap-4 py-3.5 ${i < proof.length - 1 ? "border-b border-white/10" : ""}`}
            >
              <dt class="tnum font-[var(--font-display)] text-lg text-on-ink">
                {big}
              </dt>
              <dd class="text-right text-xs uppercase tracking-[0.18em] text-on-ink/55">
                {small}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Тонкая вертикальная линия + подпись слева -->
  <div
    class="absolute bottom-0 left-5 z-[3] hidden flex-col items-center gap-3 sm:left-8 sm:flex lg:left-12"
    aria-hidden="true"
  >
    <span class="text-[10px] uppercase tracking-[0.3em] text-on-ink/40" style="writing-mode: vertical-rl">
      Вологодское Зодчество
    </span>
    <span class="h-16 w-px bg-gradient-to-b from-accent to-transparent"></span>
  </div>
</section>

<script>
  // Появление на загрузке + лёгкий параллакс (с учётом reduced-motion).
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  requestAnimationFrame(() => document.documentElement.classList.add("is-loaded"));

  const layer = document.querySelector<HTMLElement>("[data-parallax]");
  if (layer && !reduce) {
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const y = Math.min(window.scrollY, 900);
          layer.style.transform = `translateY(${y * 0.15}px) scale(1.12)`;
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
