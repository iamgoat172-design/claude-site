---
import { HERO_IMAGE } from "../data/projects";
---

<section
  id="hero"
  class="relative flex min-h-dvh items-end overflow-hidden bg-ink"
>
  <!-- Фон-фото с лёгким параллаксом -->
  <div class="absolute inset-0 -z-10 scale-110" data-parallax>
    <img
      src={HERO_IMAGE}
      alt="Премиальный дом из клееного бруса с панорамным остеклением в северном лесу в сумерках"
      class="h-full w-full object-cover"
      fetchpriority="high"
      decoding="async"
      width="2560"
      height="1097"
    />
  </div>
  <!-- Затемнение для контраста текста -->
  <div class="absolute inset-0 -z-10 scrim-bottom"></div>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/55 via-ink/10 to-transparent"
  >
  </div>

  <div class="mx-auto w-full max-w-7xl px-4 pb-16 pt-32 sm:px-6 sm:pb-24">
    <div class="max-w-2xl">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.18em] text-accent-soft backdrop-blur-md"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Премиум-линейка · от 250 м²
      </p>

      <h1
        class="font-[var(--font-display)] text-4xl font-semibold leading-[1.05] tracking-display text-on-ink text-balance sm:text-5xl lg:text-6xl"
      >
        Дома, в которых тепло
        <span class="text-accent-soft">дерева и камня</span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-on-ink/85 sm:text-lg">
        Премиальные дома из клееного бруса и тёплой керамики. Свой северный лес,
        собственное производство, договор и гарантия. Строим под ключ в Московской
        и Ленинградской областях.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="#lead"
          class="group inline-flex items-center justify-center gap-2 rounded-full bg-accent px-7 py-3.5 text-base font-semibold text-paper transition-transform duration-300 hover:scale-[1.03] focus-visible:scale-[1.03]"
        >
          Получить расчёт
          <svg
            class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="#catalog"
          class="glass inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-medium text-on-ink transition-transform duration-300 hover:scale-[1.02]"
        >
          Смотреть проекты
        </a>
      </div>

      <!-- Мини-доверие -->
      <dl
        class="mt-12 grid max-w-lg grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md"
      >
        {
          [
            ["25 лет", "на рынке"],
            ["600+", "домов сдано"],
            ["Свой лес", "Вологодчина"],
          ].map(([big, small]) => (
            <div class="px-4 py-4 text-center">
              <dt class="font-[var(--font-display)] text-lg text-on-ink sm:text-xl">
                {big}
              </dt>
              <dd class="mt-0.5 text-xs text-on-ink/65">{small}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  <!-- Скролл-подсказка -->
  <div
    class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 animate-bounce text-on-ink/50 sm:block"
    aria-hidden="true"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>

<script>
  // Лёгкий параллакс фон-фото. Отключается при prefers-reduced-motion.
  const layer = document.querySelector<HTMLElement>("[data-parallax]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (layer && !reduce) {
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const y = Math.min(window.scrollY, 800);
            layer.style.transform = `translateY(${y * 0.18}px) scale(1.1)`;
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
