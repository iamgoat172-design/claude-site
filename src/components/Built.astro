---
// Секция 7 — Построенные дома. Асимметричная галерея.
// Реальные рендеры проекта «Гранд» + кадры сдачи объектов на стадии финального
// благоустройства с владельцами. ⚠️ Сгенерированные кадры — заменить фото с участков.
import { LIFESTYLE } from "../data/projects";

const g = [
  { src: LIFESTYLE.ownersFinishing, label: "Сдача · благоустройство", place: "Одинцовский р-н, МО", cls: "sm:col-span-2 sm:row-span-2" },
  { src: "/images/projects/grand/ext-1.webp", label: "«Гранд» · 365 м²", place: "брус · МО", cls: "" },
  { src: LIFESTYLE.aerial, label: "Готовый участок", place: "Выборгский р-н, ЛО", cls: "" },
  { src: LIFESTYLE.ownersCrew, label: "Финал работ с владельцами", place: "Дмитровский р-н, МО", cls: "" },
  { src: "/images/projects/grand/ext-2.webp", label: "«Гранд» · терраса", place: "брус · МО", cls: "" },
  { src: LIFESTYLE.family, label: "Заехали и живут", place: "Всеволожский р-н, ЛО", cls: "" },
];
---

<section id="built" class="relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Построенные дома</p>
        <h2 class="display-lg mt-5 text-on-ink">Реальные объекты<br />с участков</h2>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-on-ink/65">
          Покажем дом вживую — с участка, а не с рендера. Договоримся о визите
          на ближайший к вам объект.
        </p>
      </div>
      <a
        href="#lead"
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-white/20 px-5 py-3 text-sm font-medium text-on-ink transition-colors hover:border-accent hover:text-accent sm:self-end"
      >
        Запросить тур по объекту
      </a>
    </div>

    <div class="mt-12 grid auto-rows-[200px] grid-cols-1 gap-4 sm:grid-cols-3 lg:auto-rows-[240px]">
      {
        g.map((it) => (
          <figure
            class={`rise lift group relative overflow-hidden rounded-[24px] border border-white/10 ${it.cls}`}
          >
            <img
              src={it.src}
              alt={`Построенный дом — ${it.label}, ${it.place}`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[700ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
            />
            <div class="absolute inset-0 scrim-bottom" />
            <figcaption class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-2">
              <span class="font-[var(--font-display)] text-lg text-on-ink">
                {it.label}
              </span>
              <span class="shrink-0 rounded-full bg-ink/40 px-3 py-1 text-xs text-on-ink/80 backdrop-blur-md">
                {it.place}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
