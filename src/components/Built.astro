---
// Секция 7 — Построенные дома. Асимметричная галерея.
// Реальные фотографии сданных объектов с участков в коттеджных посёлках.
import { PORTFOLIO } from "../data/projects";
const g = [
  { src: "/images/built/house-1.webp", label: "Поместье Ели · 628 м²", place: "Одинцовский р-н, МО", cls: "sm:col-span-2 sm:row-span-2" },
  { src: "/images/built/house-2.webp", label: "Семейный дом · 365 м²", place: "Истринский р-н, МО", cls: "" },
  { src: "/images/built/house-3.webp", label: "Дом из бруса · 290 м²", place: "Выборгский р-н, ЛО", cls: "" },
  { src: "/images/built/house-4.webp", label: "Современный дом · 320 м²", place: "Всеволожский р-н, ЛО", cls: "" },
  { src: "/images/built/house-5.webp", label: "Монблан · 301 м²", place: "Дмитровский р-н, МО", cls: "" },
  { src: "/images/built/house-6.webp", label: "Шале · 340 м²", place: "Приозерский р-н, ЛО", cls: "" },
  { src: "/images/built/house-7.webp", label: "Дом с террасой · 410 м²", place: "Красногорский р-н, МО", cls: "" },
  { src: "/images/built/house-9.webp", label: "Двухэтажный · 350 м²", place: "Пушкинский р-н, МО", cls: "" },
  { src: "/images/built/house-8.webp", label: "Одноэтажный · 265 м²", place: "Выборгский р-н, ЛО", cls: "" },
  { src: PORTFOLIO.hero, label: "Резиденция · авторский проект", place: "≈ 520 м² · МО", cls: "sm:col-span-3" },
];
---

<section id="built" class="relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Построенные дома</p>
        <h2 class="display-lg mt-5 text-on-ink">Реальные объекты<br />с участков</h2>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-on-ink/65">
          Покажем дом вживую — с участка, а не с рендера. Договоримся о визите
          на ближайший к вам объект.
        </p>
      </div>
      <button
        type="button"
        data-lead="tour"
        data-lead-title="Тур по построенному объекту"
        data-lead-sub="Договоримся о визите на ближайший к вам сданный объект — покажем дом вживую, с участка."
        data-lead-bullets='["Визит на реальный сданный объект","Ближайший к вашему участку дом","Ответим в удобном мессенджере"]'
        data-lead-cta="Запросить тур"
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-white/20 px-5 py-3 text-sm font-medium text-on-ink transition-colors hover:border-accent hover:text-accent sm:self-end"
      >
        Запросить тур по объекту
      </button>
    </div>

    <div class="mt-12 grid auto-rows-[200px] grid-cols-1 gap-4 sm:grid-cols-3 lg:auto-rows-[240px]">
      {
        g.map((it) => (
          <figure
            class={`rise lift group relative overflow-hidden rounded-[24px] border border-white/10 ${it.cls}`}
          >
            <img
              src={it.src}
              alt={`Построенный дом — ${it.label}, ${it.place}`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[700ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
            />
            <div class="absolute inset-0 scrim-bottom" />
            <figcaption class="absolute bottom-4 left-4 right-4 flex items-end justify-between gap-2">
              <span class="font-[var(--font-display)] text-lg text-on-ink">
                {it.label}
              </span>
              <span class="shrink-0 rounded-full bg-ink/40 px-3 py-1 text-xs text-on-ink/80 backdrop-blur-md">
                {it.place}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
