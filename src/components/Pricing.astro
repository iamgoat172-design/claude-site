---
// Секция 6 — Стоимость: как формируется цена + ипотека.
const factors = [
  { t: "Площадь и этажность", d: "Базовый объём работ и материалов." },
  { t: "Материал стен", d: "Клееный брус или тёплая керамика — разная технология." },
  { t: "Фундамент", d: "Зависит от геологии и рельефа участка." },
  { t: "Комплектация", d: "Тёплый контур, White Box или под ключ." },
  { t: "Инженерия", d: "Отопление, вода, электрика, вентиляция." },
  { t: "Логистика", d: "Удалённость участка и условия доступа техники." },
];
---

<section id="price" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Как формируется цена -->
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">
          Стоимость
        </p>
        <h2
          class="mt-3 font-[var(--font-display)] text-3xl font-semibold tracking-display text-ink text-balance sm:text-4xl"
        >
          Из чего складывается цена
        </h2>
        <p class="mt-4 text-muted">
          Считаем по вашему проекту и участку — без «средней температуры».
          Смету фиксируем в договоре: финальная сумма не меняется по ходу стройки.
        </p>

        <dl class="mt-8 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
          {
            factors.map((f) => (
              <div class="border-l-2 border-accent/30 pl-4">
                <dt class="font-medium text-ink">{f.t}</dt>
                <dd class="mt-1 text-sm text-muted">{f.d}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Ипотека / расчёт -->
      <div class="lg:pt-14">
        <div
          class="overflow-hidden rounded-[24px] border border-accent/30 bg-ink p-8 text-on-ink accent-glow"
        >
          <h3 class="font-[var(--font-display)] text-xl">Ипотека и рассрочка</h3>
          <p class="mt-3 text-on-ink/75">
            Работаем с банками по ипотеке на строительство частного дома, в том
            числе с господдержкой и семейной программой. Поможем собрать пакет
            документов и подобрать условия под ваш бюджет.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-on-ink/85">
            {
              [
                "Аккредитованы в крупных банках",
                "Поэтапная оплата по договору",
                "Рассрочка на время строительства",
              ].map((it) => (
                <li class="flex gap-3">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {it}
                </li>
              ))
            }
          </ul>
          <a
            href="#lead"
            class="mt-8 inline-flex w-full items-center justify-center rounded-full bg-accent px-6 py-3.5 text-base font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]"
          >
            Рассчитать стоимость дома
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
