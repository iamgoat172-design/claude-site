---
// Секция — Люди и востребованность. Три слоя:
//  1) Lifestyle-полоса «в этих домах живут» (фото-якорь людей);
//  2) Команда, которая отвечает за ваш дом (человеческая гарантия безопасности);
//  3) Живой спрос: счётчики + ограничение слотов сезона (социальная востребованность).
//
// ⚠️ Заглушки: имена команды, портреты и цифры спроса — замените реальными.
//    Слот под фото людей помечен data-people-photo.
import { LIFESTYLE, PORTFOLIO } from "../data/projects";

const lifestyle = LIFESTYLE.family;

// Визуальные доказательства — реальные кадры объектов и сдач.
const proofShots = [
  { src: LIFESTYLE.ownersFinishing, cap: "Сдача объекта · МО" },
  { src: LIFESTYLE.ownersCrew, cap: "Благоустройство · ЛО" },
  { src: PORTFOLIO.hero, cap: "Готовый дом · Подмосковье" },
  { src: LIFESTYLE.aerial, cap: "Участок с высоты" },
];

// Команда проекта — реальные люди. Недостающих добавим по мере получения фото.
const team = [
  { name: "Евгений Сесявин", role: "Генеральный директор", duty: "Ведёт компанию и лично отвечает за результат и ваши гарантии.", photo: "/images/team/director.webp" },
  { name: "Вячеслав Корольков", role: "Руководитель инженерии и отделки", duty: "Инженерные системы, конструктив и чистовая отделка вашего дома.", photo: "/images/team/engineering.webp" },
  { name: "Анастасия Матасова", role: "Архитектор", duty: "Проектирует дом под ваш участок, виды и сценарий жизни.", photo: "/images/team/architect.webp" },
  { name: "Руслан Ивановский", role: "Руководитель направления в Санкт-Петербурге", duty: "Ведёт проекты и стройку в Ленинградской области.", photo: "/images/team/spb.webp" },
  { name: "Андрей Грибков", role: "Руководитель направления в Московской области", duty: "Ведёт проекты и стройку в Подмосковье.", photo: "/images/team/msk.webp" },
];

// Цифры живого спроса (заглушки — обновляйте под реальные).
const demand = [
  { to: 114, suffix: "", label: "домов сдали в этом году по группе компаний" },
  { to: 640, suffix: "+", label: "семей уже живут в наших домах" },
  { to: 12, suffix: "", label: "домов в работе прямо сейчас" },
  { to: 5, suffix: "", label: "мест на стройку осталось", scarce: true },
];
---

<section id="people" class="relative overflow-hidden bg-ink-2 py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Люди и доверие</p>
        <h2 class="display-lg mt-5 text-on-ink">За каждым домом —<br />люди, а не подрядчик</h2>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-on-ink/65">
        Вы знаете имена тех, кто строит ваш дом, и видите семьи, которые уже
        в них живут. Это и есть гарантия: спокойствие, что всё будет хорошо.
      </p>
    </div>

    <!-- Командное фото + подпись (подпись под фото, чтобы не перекрывать лица) -->
    <figure class="rise mt-12 overflow-hidden rounded-[28px] border border-white/10">
      <img
        src="/images/team.webp"
        data-people-photo
        alt="Команда компании «Вологодское Зодчество»"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover object-top sm:aspect-[2/1]"
      />
    </figure>
    <div class="rise mt-5 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xl">
        <p class="font-[var(--font-display)] text-2xl leading-snug text-on-ink sm:text-3xl">
          Команда «Вологодского&nbsp;Зодчества»
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-on-ink/65">
          Архитекторы, инженеры и прорабы, которые строят ваш дом. Вместе
          с&nbsp;1998&nbsp;года — это и есть гарантия, что всё будет хорошо.
        </p>
      </div>
      <button type="button" data-lead="individual" data-lead-title="Обсудить ваш проект" data-lead-sub="Расскажем о команде, покажем объекты и подберём решение под ваш участок." data-lead-bullets='["Закреплённая команда на ваш проект","Договор с фиксированной сметой","Оплата с юрлица на юрлицо","Гарантия 25 лет"]' data-lead-cta="Обсудить проект" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
        Обсудить ваш проект
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <!-- Визуальные доказательства -->
    <div class="rise mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        proofShots.map((p) => (
          <figure class="relative overflow-hidden rounded-[20px] border border-white/10">
            <img src={p.src} alt={p.cap} loading="lazy" decoding="async" class="aspect-[4/3] h-full w-full object-cover" />
            <div class="absolute inset-0 scrim-bottom"></div>
            <figcaption class="absolute bottom-3 left-3 right-3 text-xs text-on-ink/90">{p.cap}</figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Почему нам доверяют — смысловые блоки -->
    <div class="mt-16">
      <h3 class="font-[var(--font-display)] text-xl text-on-ink sm:text-2xl">Почему нам доверяют большие бюджеты</h3>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { t: "Производитель, а не посредник", d: "Свой лес в Вологодской области и завод клееного бруса. Контролируем качество от делянки до сборки — и отвечаем за него." },
            { t: "С 1998 года, 1500+ домов", d: "Больше 25 лет строим большие дома в Подмосковье и Ленобласти. Покажем построенные объекты и свяжем с владельцами." },
            { t: "Фиксированная цена в договоре", d: "Смета не растёт по ходу стройки. Оплата с юрлица на юрлицо, поэтапно — официально и прозрачно." },
            { t: "Гарантия 25 лет и надзор", d: "Поэтапная приёмка, авторский надзор и гарантийное сопровождение после сдачи дома." },
          ].map((r, i) => (
            <article class={`rise rise-${Math.min(i + 1, 4)} flex flex-col rounded-[20px] border border-white/10 bg-white/[0.02] p-6`}>
              <span class="tnum font-[var(--font-display)] text-2xl text-accent-soft">{`0${i + 1}`}</span>
              <p class="mt-3 font-[var(--font-display)] text-on-ink">{r.t}</p>
              <p class="mt-2 text-sm leading-relaxed text-on-ink/60">{r.d}</p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- 2) Команда проекта -->
    <div class="mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-[var(--font-display)] text-xl text-on-ink sm:text-2xl">Команда, которая отвечает за ваш дом</h3>
        <span class="hidden text-sm text-on-ink/45 sm:block">Закреплены за вашим проектом</span>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          team.map((m, i) => (
            <article class={`rise rise-${Math.min(i + 1, 4)} glass hairline-top flex flex-col overflow-hidden rounded-[22px]`}>
              <div class="aspect-[4/5] w-full overflow-hidden bg-ink-2">
                <img src={m.photo} alt={`${m.name} — ${m.role}`} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <p class="font-[var(--font-display)] text-lg text-on-ink">{m.name}</p>
                <p class="mt-0.5 text-sm text-accent-soft">{m.role}</p>
                <p class="mt-3 text-sm leading-relaxed text-on-ink/65">{m.duty}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Безопасная сделка — снимаем страх крупной покупки -->
    <div class="rise mt-14 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        [
          { t: "Договор и фиксированная смета", d: "Цена закреплена в договоре и не растёт по ходу стройки", icon: '<path d="M8 4h8a2 2 0 012 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 012-2z" stroke-linejoin="round"/><path d="M9 9h6M9 13h6" stroke-linecap="round"/>' },
          { t: "Оплата с юрлица на юрлицо", d: "Официально и прозрачно, поэтапно, удобно для бизнеса", icon: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4" stroke-linecap="round"/>' },
          { t: "Гарантия 25 лет", d: "Поэтапная приёмка, авторский надзор, сопровождение после сдачи", icon: '<path d="M12 3l7 4v5c0 4.5-3 8.5-7 9.5-4-1-7-5-7-9.5V7l7-4z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>' },
        ].map((s) => (
          <div class="glass hairline-top flex items-start gap-4 rounded-[20px] p-6">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-accent/40 text-accent-soft accent-glow">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" set:html={s.icon} />
            </span>
            <div>
              <p class="font-[var(--font-display)] text-on-ink">{s.t}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-on-ink/60">{s.d}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- 3) Живой спрос -->
    <div class="rise mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-[24px] border border-white/10 lg:grid-cols-4" data-demand>
      {
        demand.map((d) => (
          <div class="bg-white/[0.02] px-6 py-8">
            <p class="flex items-baseline gap-1">
              <span class="tnum font-[var(--font-display)] text-3xl text-on-ink sm:text-4xl" data-count={d.to} data-suffix={d.suffix}>0{d.suffix}</span>
              {d.scarce && (
                <span class="ml-1 inline-flex h-2 w-2 rounded-full bg-accent" aria-hidden="true">
                  <span class="h-2 w-2 animate-ping rounded-full bg-accent" />
                </span>
              )}
            </p>
            <p class={`mt-3 text-sm leading-snug ${d.scarce ? "text-accent-soft" : "text-on-ink/55"}`}>{d.label}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-4">
      <button type="button" data-quiz="complectation" class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
        Забронировать старт в этом сезоне
      </button>
      <span class="text-sm text-on-ink/50">Бесплатный расчёт · ни к чему не обязывает</span>
    </div>
  </div>
</section>

<script>
  // Счётчики живого спроса. Уважает prefers-reduced-motion.
  const wrap = document.querySelector<HTMLElement>("[data-demand]");
  if (wrap) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nums = Array.from(wrap.querySelectorAll<HTMLElement>("[data-count]"));
    const run = () => {
      nums.forEach((el) => {
        const to = Number(el.dataset.count || "0");
        const suffix = el.dataset.suffix || "";
        if (reduce) { el.textContent = `${to}${suffix}`; return; }
        const dur = 1100, t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = `${Math.round(to * eased)}${suffix}`;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((ents) => ents.forEach((e) => { if (e.isIntersecting) { run(); io.disconnect(); } }), { threshold: 0.3 });
      io.observe(wrap);
    } else run();
  }
</script>
