---
// Секция 2 — Доверие. Стеклянная полоса с цифрами-доказательствами.
const items = [
  { big: "25 лет", small: "на рынке загородного строительства" },
  { big: "600+", small: "домов построено и сдано" },
  { big: "Свой лес", small: "и производство в Вологодской области" },
  { big: "Договор", small: "фиксированная смета и гарантия" },
];
---

<section id="trust" class="relative z-20 bg-paper">
  <div class="mx-auto -mt-14 max-w-7xl px-4 sm:px-6">
    <div
      class="glass-light hairline-top grid grid-cols-2 gap-px overflow-hidden rounded-[24px] lg:grid-cols-4"
    >
      {
        items.map((it) => (
          <div class="bg-white/40 px-6 py-7 text-center sm:py-9">
            <p class="font-[var(--font-display)] text-2xl text-ink sm:text-3xl">
              {it.big}
            </p>
            <p class="mx-auto mt-2 max-w-[14rem] text-sm leading-snug text-muted">
              {it.small}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
