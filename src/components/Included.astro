---
// Секция 4 — Что входит. Редакционные строки-уровни (не 3 карточки).
const tiers = [
  {
    n: "01",
    name: "Тёплый контур",
    lead: "Дом готов к внутренним работам",
    items: "Фундамент под геологию · стены из бруса или керамики · кровля с утеплением · панорамные окна · черновые входные группы",
  },
  {
    n: "02",
    name: "White Box",
    lead: "Под чистовую отделку",
    featured: true,
    items: "Всё из «Тёплого контура» · разводка отопления, воды, электрики · стяжка и выравнивание · вентиляция · подготовка под кухню и санузлы",
  },
  {
    n: "03",
    name: "Под ключ",
    lead: "Заезжайте и живите",
    items: "Всё из «White Box» · чистовая отделка по дизайн-проекту · котёл, сантехника, свет · двери, лестницы, встроенные решения · благоустройство входа",
  },
];
---

<section id="included" class="relative overflow-hidden bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[4fr_8fr] lg:gap-16">
      <!-- Опенер -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow text-accent-soft">Что входит в дом</p>
        <h2 class="display-lg mt-5 text-on-ink">Три уровня<br />готовности</h2>
        <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-on-ink/65">
          Берём дом на любом этапе и доводим до нужного. Состав работ — в
          договоре и смете, без «вылезающих» строк по ходу стройки.
        </p>
      </div>

      <!-- Строки-уровни -->
      <div class="border-t border-white/10">
        {
          tiers.map((t) => (
            <article
              class={`rise group grid grid-cols-1 gap-4 border-b border-white/10 py-8 transition-colors duration-500 sm:grid-cols-[auto_1fr] sm:gap-8 ${t.featured ? "bg-white/[0.02]" : "hover:bg-white/[0.015]"}`}
            >
              <div class="flex items-center gap-4 sm:flex-col sm:items-start sm:gap-2">
                <span class="tnum font-[var(--font-display)] text-2xl text-accent-soft">
                  {t.n}
                </span>
                {t.featured && (
                  <span class="rounded-full border border-accent/40 px-2.5 py-0.5 text-[10px] uppercase tracking-[0.16em] text-accent-soft">
                    Выбирают чаще
                  </span>
                )}
              </div>
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="font-[var(--font-display)] text-2xl text-on-ink">
                    {t.name}
                  </h3>
                  <span class="text-sm text-on-ink/50">{t.lead}</span>
                </div>
                <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-on-ink/65">
                  {t.items}
                </p>
                <a
                  href="#lead"
                  class="mt-4 inline-flex text-sm font-semibold text-accent transition-colors hover:text-accent-soft"
                >
                  Рассчитать в этой комплектации →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
