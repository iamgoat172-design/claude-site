---
// Секция 4 — Что входит в дом. Уровни комплектации/отделки.
const tiers = [
  {
    name: "Тёплый контур",
    lead: "Дом готов к внутренним работам",
    items: [
      "Фундамент под проект и геологию участка",
      "Несущие стены: клееный брус или тёплая керамика",
      "Кровля с утеплением и водостоком",
      "Окна с панорамным остеклением",
      "Черновые входные группы",
    ],
  },
  {
    name: "White Box",
    lead: "Под чистовую отделку",
    featured: true,
    items: [
      "Всё из «Тёплого контура»",
      "Разводка отопления, воды, электрики",
      "Стяжка пола и выравнивание стен",
      "Вентиляция и подготовка под кухню/санузлы",
      "Межкомнатные проёмы",
    ],
  },
  {
    name: "Под ключ",
    lead: "Заезжайте и живите",
    items: [
      "Всё из «White Box»",
      "Чистовая отделка по дизайн-проекту",
      "Инженерия в работе: котёл, сантехника, свет",
      "Двери, лестницы, встроенные решения",
      "Благоустройство входной зоны",
    ],
  },
];
---

<section id="included" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">
        Что входит в дом
      </p>
      <h2
        class="mt-3 font-[var(--font-display)] text-3xl font-semibold tracking-display text-ink text-balance sm:text-4xl"
      >
        Три уровня готовности
      </h2>
      <p class="mt-4 text-muted">
        Берём дом на любом этапе и доводим до нужного. Состав работ фиксируем
        в договоре и смете — без «вылезающих» строк по ходу стройки.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        tiers.map((t) => (
          <article
            class={`lift relative overflow-hidden rounded-[24px] border p-7 ${
              t.featured
                ? "border-accent/40 bg-ink text-on-ink accent-glow"
                : "border-black/5 bg-white text-ink shadow-[0_12px_40px_rgba(20,22,27,0.06)]"
            }`}
          >
            {t.featured && (
              <span class="absolute right-5 top-5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-paper">
                Выбирают чаще
              </span>
            )}
            <h3 class="font-[var(--font-display)] text-xl">{t.name}</h3>
            <p
              class={`mt-1 text-sm ${t.featured ? "text-on-ink/65" : "text-muted"}`}
            >
              {t.lead}
            </p>
            <ul class="mt-6 space-y-3">
              {t.items.map((it) => (
                <li class="flex gap-3 text-sm leading-snug">
                  <svg
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 13l4 4L19 7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class={t.featured ? "text-on-ink/85" : "text-ink/75"}>
                    {it}
                  </span>
                </li>
              ))}
            </ul>
            <a
              href="#lead"
              class={`mt-7 inline-flex text-sm font-semibold transition-colors ${
                t.featured
                  ? "text-accent-soft hover:text-paper"
                  : "text-accent hover:text-ink"
              }`}
            >
              Рассчитать в этой комплектации →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
