---
// Секция 5 — Этапы. Горизонтальная шкала с глубиной.
const stages = [
  { n: "01", t: "Заявка и расчёт", d: "Обсуждаем участок, материал и бюджет. Готовим предварительную смету." },
  { n: "02", t: "Проект и смета", d: "Планировки, узлы, фиксированная смета. Согласуем до рубля." },
  { n: "03", t: "Договор", d: "Сроки, этапы оплат, гарантия. Всё письменно." },
  { n: "04", t: "Производство", d: "Брус и керамика — со своего леса и проверенных заводов." },
  { n: "05", t: "Стройка", d: "Фундамент, коробка, кровля, инженерия. Контроль на каждом этапе." },
  { n: "06", t: "Сдача под ключ", d: "Проверка, документы, ключи. Выходим на гарантийное сопровождение." },
];
---

<section id="stages" class="relative overflow-hidden bg-ink py-20 sm:py-28">
  <div
    class="pointer-events-none absolute right-0 top-1/3 -z-0 h-[400px] w-[600px] rounded-full opacity-[0.1] blur-[120px]"
    style="background: radial-gradient(closest-side, #B0885A, transparent)"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent-soft">
        Как мы работаем
      </p>
      <h2
        class="mt-3 font-[var(--font-display)] text-3xl font-semibold tracking-display text-on-ink text-balance sm:text-4xl"
      >
        От заявки до ключей
      </h2>
      <p class="mt-4 text-on-ink/70">
        Шесть понятных этапов. На каждом — ответственный и отчёт: вы всегда
        знаете, что происходит на стройке.
      </p>
    </div>

    <!-- Шкала: горизонтальный скролл на мобиле, сетка на десктопе -->
    <ol
      class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 [scrollbar-width:none] lg:grid lg:grid-cols-6 lg:overflow-visible"
    >
      {
        stages.map((s, i) => (
          <li
            class="group relative min-w-[78%] snap-start sm:min-w-[45%] lg:min-w-0"
            style={`z-index: ${stages.length - i}`}
          >
            <div class="glass hairline-top h-full rounded-[20px] p-6 transition-transform duration-500 group-hover:-translate-y-1.5">
              <span class="font-[var(--font-display)] text-2xl text-accent-soft">
                {s.n}
              </span>
              <h3 class="mt-3 font-[var(--font-display)] text-base text-on-ink">
                {s.t}
              </h3>
              <p class="mt-2 text-sm leading-snug text-on-ink/65">{s.d}</p>
            </div>
            {i < stages.length - 1 && (
              <span
                class="absolute -right-3 top-1/2 hidden h-px w-6 -translate-y-1/2 bg-gradient-to-r from-accent/60 to-transparent lg:block"
                aria-hidden="true"
              />
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
