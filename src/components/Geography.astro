---
// Секция 10 — География. Московская и Ленинградская области.
const regions = [
  {
    name: "Московская область",
    areas: [
      "Дмитровское, Рублёво-Успенское, Новорижское ш.",
      "Истринский, Одинцовский, Пушкинский районы",
      "Минское, Калужское, Ярославское направления",
    ],
  },
  {
    name: "Ленинградская область",
    areas: [
      "Всеволожский, Выборгский, Приозерский районы",
      "Курортное и Приозерское направления",
      "Ближний и средний радиус от КАД",
    ],
  },
];
---

<section id="geo" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">
          География
        </p>
        <h2
          class="mt-3 font-[var(--font-display)] text-3xl font-semibold tracking-display text-ink text-balance sm:text-4xl"
        >
          Где мы строим
        </h2>
        <p class="mt-4 text-muted">
          Работаем в Московской и Ленинградской областях. Производство — в
          Вологодской области, оттуда же собственный лес. Выезжаем на участок
          для замеров и оценки логистики.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            regions.map((r) => (
              <div class="rounded-[20px] border border-black/5 bg-white p-6 shadow-[0_12px_40px_rgba(20,22,27,0.05)]">
                <h3 class="font-[var(--font-display)] text-base text-ink">
                  {r.name}
                </h3>
                <ul class="mt-3 space-y-2 text-sm text-muted">
                  {r.areas.map((a) => (
                    <li class="flex gap-2">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Стилизованная карта-заглушка (заменить на интерактивную) -->
      <div
        class="glass-light hairline-top relative aspect-[4/3] overflow-hidden rounded-[28px]"
        aria-hidden="true"
      >
        <svg viewBox="0 0 400 300" class="h-full w-full" fill="none">
          <defs>
            <radialGradient id="glow" cx="50%" cy="40%" r="60%">
              <stop offset="0%" stop-color="#B0885A" stop-opacity="0.18" />
              <stop offset="100%" stop-color="#B0885A" stop-opacity="0" />
            </radialGradient>
          </defs>
          <rect width="400" height="300" fill="url(#glow)" />
          <g stroke="#6B6F78" stroke-opacity="0.25" stroke-width="1">
            <path d="M40 90 Q120 40 210 80 T370 110 L350 220 Q230 270 120 230 T40 200 Z" fill="#ECEBE7" fill-opacity="0.5" />
            <path d="M210 80 Q160 140 180 200" />
            <path d="M120 110 Q200 130 300 120" />
          </g>
          <g>
            <circle cx="150" cy="170" r="6" fill="#B0885A" />
            <circle cx="150" cy="170" r="14" fill="#B0885A" fill-opacity="0.2" />
            <text x="150" y="200" text-anchor="middle" fill="#14161B" font-size="11" font-family="Manrope">Москва</text>
            <circle cx="300" cy="110" r="6" fill="#B0885A" />
            <circle cx="300" cy="110" r="14" fill="#B0885A" fill-opacity="0.2" />
            <text x="300" y="140" text-anchor="middle" fill="#14161B" font-size="11" font-family="Manrope">Санкт-Петербург</text>
          </g>
        </svg>
        <p class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs text-muted">
          Карта — схематично. Интерактивную добавим на готовом сайте.
        </p>
      </div>
    </div>
  </div>
</section>
