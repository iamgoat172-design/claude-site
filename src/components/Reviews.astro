---
// Секция 8 — Отзывы. (Тексты — заглушки, заменить реальными.)
const featured = {
  text: "Дом из бруса 280 м² построили за один сезон. Главное — смета не поползла: заплатили ровно столько, сколько подписали в договоре.",
  name: "Сергей и Анна",
  place: "дом 280 м², брус · Истра",
};
const more = [
  {
    text: "Выбрали тёплую керамику из-за тишины и инерции тепла. Зимой топим экономно, летом прохладно.",
    name: "Дмитрий К.",
    place: "312 м², керамика · Всеволожск",
  },
  {
    text: "Проектировали под сложный участок с уклоном. Бюро предложило решение, до которого мы бы сами не додумались.",
    name: "Марина В.",
    place: "340 м², брус · Одинцово",
  },
];
---

<section id="reviews" class="relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <p class="eyebrow text-accent-soft">Отзывы</p>
    <h2 class="display-lg mt-5 text-on-ink">Что говорят<br />владельцы</h2>

    <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-[7fr_5fr] lg:gap-16">
      <!-- Крупная цитата -->
      <figure class="rise flex flex-col justify-between border-t border-accent/30 pt-8">
        <blockquote class="font-[var(--font-display)] text-2xl leading-[1.3] tracking-display text-on-ink sm:text-[2rem]">
          «{featured.text}»
        </blockquote>
        <figcaption class="mt-8">
          <p class="font-medium text-on-ink">{featured.name}</p>
          <p class="mt-1 text-sm text-on-ink/55">{featured.place}</p>
        </figcaption>
      </figure>

      <!-- Поменьше -->
      <div class="flex flex-col">
        {
          more.map((r, i) => (
            <figure class={`rise rise-${i + 2} flex flex-col gap-5 border-t border-white/10 py-7`}>
              <blockquote class="text-[15px] leading-relaxed text-on-ink/80">
                «{r.text}»
              </blockquote>
              <figcaption>
                <p class="text-sm font-medium text-on-ink">{r.name}</p>
                <p class="mt-0.5 text-xs text-on-ink/50">{r.place}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
