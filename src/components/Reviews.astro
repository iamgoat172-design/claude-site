---
// Секция 8 — Отзывы. Соц-доказательство: агрегат-рейтинг + цитаты с аватарами.
// ⚠️ Тексты, имена и цифры рейтинга — заглушки, заменить реальными.
const featured = {
  text: "Дом из бруса 280 м² построили за один сезон. Главное — смета не поползла: заплатили ровно столько, сколько подписали в договоре. Оплачивали с нашей компании на их юрлицо — всё официально.",
  name: "Сергей и Анна",
  place: "дом 280 м², брус · Истра, МО",
};
const more = [
  {
    text: "Выбрали тёплую керамику из-за тишины и инерции тепла. Зимой топим экономно, летом прохладно.",
    name: "Дмитрий Кузнецов",
    place: "312 м², керамика · Всеволожск, ЛО",
  },
  {
    text: "Проектировали под сложный участок с уклоном. Бюро предложило решение, до которого мы бы сами не додумались.",
    name: "Марина Власова",
    place: "340 м², брус · Одинцово, МО",
  },
  {
    text: "Возили на свой завод и на сданный объект до подписания договора. После этого вопросов, кому доверить дом, не осталось.",
    name: "Олег Терентьев",
    place: "365 м², брус · Дмитров, МО",
  },
];

// Агрегированный рейтинг (заглушка).
const rating = { score: "4.9", count: "120+", recommend: "9 из 10" };

const initials = (name: string) =>
  name.split(/[ -]/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
---

<section id="reviews" class="relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Отзывы</p>
        <h2 class="display-lg mt-5 text-on-ink">Что говорят<br />владельцы</h2>
      </div>
      <!-- Агрегат-рейтинг -->
      <div class="rise flex flex-wrap items-center gap-x-8 gap-y-4">
        <div class="flex items-center gap-3">
          <span class="tnum font-[var(--font-display)] text-4xl text-on-ink">{rating.score}</span>
          <span class="flex flex-col">
            <span class="flex text-accent" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 18.1 5.9 21.4l1.4-6.8L2.2 9.9l6.9-.8L12 2z"/></svg>
              ))}
            </span>
            <span class="mt-1 text-xs text-on-ink/50">{rating.count} отзывов владельцев</span>
          </span>
        </div>
        <div class="border-l border-white/10 pl-8">
          <p class="tnum font-[var(--font-display)] text-2xl text-on-ink">{rating.recommend}</p>
          <p class="mt-1 text-xs text-on-ink/50">рекомендуют знакомым</p>
        </div>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-[7fr_5fr] lg:gap-16">
      <!-- Крупная цитата -->
      <figure class="rise flex flex-col justify-between border-t border-accent/30 pt-8">
        <blockquote class="font-[var(--font-display)] text-2xl leading-[1.3] tracking-display text-on-ink sm:text-[2rem]">
          «{featured.text}»
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4">
          <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-accent/40 bg-white/5 font-[var(--font-display)] text-accent-soft">
            {initials(featured.name)}
          </span>
          <span>
            <span class="block font-medium text-on-ink">{featured.name}</span>
            <span class="mt-0.5 block text-sm text-on-ink/55">{featured.place}</span>
          </span>
        </figcaption>
      </figure>

      <!-- Поменьше -->
      <div class="flex flex-col">
        {
          more.map((r, i) => (
            <figure class={`rise rise-${i + 2} flex flex-col gap-4 border-t border-white/10 py-6`}>
              <blockquote class="text-[15px] leading-relaxed text-on-ink/80">
                «{r.text}»
              </blockquote>
              <figcaption class="flex items-center gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/15 bg-white/5 text-xs font-semibold text-on-ink/80">
                  {initials(r.name)}
                </span>
                <span>
                  <span class="block text-sm font-medium text-on-ink">{r.name}</span>
                  <span class="mt-0.5 block text-xs text-on-ink/50">{r.place}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <!-- Видео-отзывы — RuTube, грузятся по клику (фасад) -->
    <div class="mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-[var(--font-display)] text-xl text-on-ink sm:text-2xl">Видео-отзывы владельцев</h3>
        <span class="hidden text-sm text-on-ink/45 sm:block">Сняты на сданных объектах</span>
      </div>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          [
            { id: "e01c839b6103d87400574a0754da96a9", who: "Видео-отзыв владельца", place: "построенный дом" },
            { id: "23156a3251869386dd095cc98902b00b", who: "Видео-отзыв владельца", place: "построенный дом" },
            { id: "cd9c111d2addd9c45c4f5ec57f87ca08", who: "Видео-отзыв владельца", place: "построенный дом" },
          ].map((v) => (
            <figure class="group relative aspect-video overflow-hidden rounded-[22px] border border-white/10 bg-ink-2" data-rutube={v.id}>
              <button type="button" data-rutube-play aria-label="Смотреть видео-отзыв" class="absolute inset-0 z-10 grid place-items-center">
                <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_50%_-10%,rgba(176,136,90,0.14),transparent_60%)]" />
                <span class="relative grid h-14 w-14 place-items-center rounded-full border border-white/25 bg-white/5 backdrop-blur-md transition-transform duration-300 group-hover:scale-105">
                  <svg class="ml-1 h-6 w-6 text-on-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                </span>
              </button>
              <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 z-10 flex items-center justify-between gap-2 bg-gradient-to-t from-ink/80 to-transparent p-4 text-sm">
                <span class="font-medium text-on-ink">{v.who}</span>
                <span class="text-xs text-on-ink/55">{v.place}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLElement>("[data-rutube]").forEach((fig) => {
      const btn = fig.querySelector<HTMLButtonElement>("[data-rutube-play]");
      btn?.addEventListener("click", () => {
        const id = fig.dataset.rutube;
        const iframe = document.createElement("iframe");
        iframe.src = `https://rutube.ru/play/embed/${id}/?autoStart=true`;
        iframe.className = "absolute inset-0 h-full w-full";
        iframe.setAttribute("frameborder", "0");
        iframe.setAttribute("allow", "clipboard-write; autoplay; fullscreen");
        iframe.setAttribute("allowfullscreen", "true");
        iframe.title = "Видео-отзыв владельца";
        fig.replaceChildren(iframe);
      });
    });
  </script>
</section>
