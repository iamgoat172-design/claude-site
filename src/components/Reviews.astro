---
// Секция 8 — Отзывы клиентов. (Тексты — заглушки, заменить реальными.)
const reviews = [
  {
    text: "Дом из бруса 280 м² построили за один сезон. Понравилось, что смета не поползла — заплатили ровно столько, сколько подписали в договоре.",
    name: "Сергей и Анна",
    place: "дом 280 м², брус · Истра",
  },
  {
    text: "Выбрали тёплую керамику из-за тишины и инерции тепла. Зимой топим экономно, летом прохладно. Прораб был на связи весь процесс.",
    name: "Дмитрий К.",
    place: "дом 312 м², керамика · Всеволожск",
  },
  {
    text: "Проектировали под наш сложный участок с уклоном. Бюро предложило решение, до которого мы бы сами не додумались. Спасибо за терпение.",
    name: "Марина В.",
    place: "дом 340 м², брус · Одинцово",
  },
];
---

<section id="reviews" class="bg-paper py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-accent">
        Отзывы
      </p>
      <h2
        class="mt-3 font-[var(--font-display)] text-3xl font-semibold tracking-display text-ink text-balance sm:text-4xl"
      >
        Что говорят владельцы
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        reviews.map((r) => (
          <figure class="lift flex flex-col justify-between rounded-[24px] border border-black/5 bg-white p-7 shadow-[0_12px_40px_rgba(20,22,27,0.06)]">
            <div>
              <svg
                class="h-7 w-7 text-accent/40"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M9 7H5a2 2 0 00-2 2v4a2 2 0 002 2h2v3l3-3V9a2 2 0 00-1-1.7M19 7h-4a2 2 0 00-2 2v4a2 2 0 002 2h2v3l3-3V9a2 2 0 00-1-1.7" />
              </svg>
              <blockquote class="mt-4 text-ink/85">{r.text}</blockquote>
            </div>
            <figcaption class="mt-6 border-t border-black/5 pt-4">
              <p class="font-medium text-ink">{r.name}</p>
              <p class="mt-0.5 text-sm text-muted">{r.place}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
