    const collectionRow = (p: P, active: boolean, i: number) => `<button type="button" data-select="${p.code}" role="option" aria-selected="${active}" class="group flex w-full items-center gap-4 border-b border-white/10 py-4 text-left transition-colors duration-300">
      <span class="h-5 w-px shrink-0 bg-accent opacity-0 transition-opacity group-aria-selected:opacity-100"></span>
      <span class="tnum text-xs text-on-ink/30 transition-colors group-aria-selected:text-accent-soft">${String(i + 1).padStart(2, "0")}</span>
      <span class="font-[var(--font-display)] text-lg text-on-ink/45 transition-colors group-aria-selected:text-on-ink group-hover:text-on-ink/80 sm:text-xl">${p.name}</span>
