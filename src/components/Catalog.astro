    const tableCard = (p: P, active: boolean, i: number) => {
      const s = slots[i % slots.length];
      return `<button type="button" data-select="${p.code}" role="option" aria-selected="${active}" class="group absolute overflow-hidden rounded-[20px] border border-white/10 shadow-[0_28px_70px_rgba(0,0,0,.5)] transition-[box-shadow,outline] duration-300 hover:z-30 aria-selected:outline aria-selected:outline-2 aria-selected:outline-accent" style="left:${s.x}px;top:${s.y}px;width:${s.w}px">
        <span class="block aspect-[4/3] overflow-hidden"><img src="${p.image}" alt="${p.alt}" loading="lazy" draggable="false" class="h-full w-full object-cover transition-transform duration-[800ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"></span>
        <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent"></span>
        <span class="pointer-events-none absolute left-3 top-3 flex items-center gap-2"><span class="rounded-full border border-white/20 bg-ink/40 px-2.5 py-1 text-[10px] tracking-wide text-on-ink backdrop-blur-md">${p.code}</span>${p.tag ? `<span class="rounded-full bg-accent/90 px-2.5 py-1 text-[10px] font-semibold text-paper">${p.tag}</span>` : ""}</span>
        <span class="pointer-events-none absolute inset-x-0 bottom-0 p-4"><span class="block font-[var(--font-display)] text-xl text-on-ink">${p.name}</span><span class="block text-xs text-accent-soft">${p.hook}</span></span>
      </button>`;
    };
    const cardMarkup = (p: P, active: boolean, i = 0) => isTable ? tableCard(p, active, i) : isCollection ? collectionRow(p, active, i) : (isCoverflow ? coverCard : isShowcase ? thumbCard : bigCard)(p, active);

    let spreadIO: IntersectionObserver | null = null;
    const observeSpreads = () => {
      spreadIO?.disconnect();
      spreadIO = new IntersectionObserver((ents) => ents.forEach((e) => { if (e.isIntersecting && e.intersectionRatio > 0.55) { const c = (e.target as HTMLElement).dataset.select; if (c) selected = c; } }), { root: list, threshold: [0.55] });
      list.querySelectorAll<HTMLElement>("[data-select]").forEach((s) => spreadIO!.observe(s));
    };

    const buildList = (groupId: string) => {
      const g = data.groups.find((x) => x.id === groupId)!;
      codesNow = g.codes;
      if (isSpread) { list.innerHTML = g.codes.map((c, i) => spreadCard(data.projects[c], i, g.codes.length)).join(""); observeSpreads(); return; }
      list.innerHTML = g.codes.map((c, i) => cardMarkup(data.projects[c], i === 0, i)).join("");
      if (isCoverflow) layoutCover(0);
      if (dotsEl) dotsEl.innerHTML = g.codes.map(() => `<button type="button" data-dot class="h-1.5 w-1.5 rounded-full bg-white/25"></button>`).join("");
    };

    const switchMaterial = (groupId: string, focus = false) => {
      tabs.forEach((t) => { const s = t.dataset.tab === groupId; t.setAttribute("aria-selected", String(s)); t.tabIndex = s ? 0 : -1; if (s) { moveIndicator(t); if (focus) t.focus(); } });
      const g = data.groups.find((x) => x.id === groupId)!;
      note.style.opacity = "0";
      setTimeout(() => { note.textContent = `${g.note}. Переключайте проекты справа, открывайте карточку — внутри визуализации, интерьеры и планировки.`; note.style.opacity = "1"; }, reduce ? 0 : 160);
      buildList(groupId); selectProject(g.codes[0]);
      if (isTable && tableFit) tableFit();
    };
    note.style.transition = "opacity .3s ease";

    tabs.forEach((tab) => tab.addEventListener("click", () => switchMaterial(tab.dataset.tab!)));
    root.querySelector("[data-tablist]")!.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent; const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true"); let next = cur;
      if (ev.key === "ArrowRight") next = (cur + 1) % tabs.length; else if (ev.key === "ArrowLeft") next = (cur - 1 + tabs.length) % tabs.length;
      else if (ev.key === "Home") next = 0; else if (ev.key === "End") next = tabs.length - 1; else return;
      ev.preventDefault(); switchMaterial(tabs[next].dataset.tab!, true);
    });
    list.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>("[data-select]");
      if (!b) return;
      const code = b.dataset.select!;
      if (isTable) return; // «стол» обрабатывает клик сам (с учётом drag)
      if (isSpread) return; // в развороте действуют кнопки внутри
      if (isCoverflow) {
        if ((e.target as HTMLElement).closest("[data-open],[data-calc]")) return; // кнопки внутри карточки обрабатывает делегирование
        if (code === selected) openModal(code); else selectProject(code);
        return;
      }
      if (isCollection) { selectProject(code); return; } // смена кадра; проект открывает CTA
      selectProject(code);
      if (!canHover) openModal(code); // на тач — сразу карточка
    });
    // Живой предпросмотр при наведении (только список/кинолента)
    if (canHover && !isCoverflow && !isSpread && !isTable && !isCollection) {
      list.addEventListener("mouseover", (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>("[data-select]"); if (b) applyFeatured(b.dataset.select!); });
      list.addEventListener("mouseleave", () => applyFeatured(selected));
    }

    // Навигация showcase/coverflow/collection: стрелки, точки, клавиатура
    if (isShowcase || isCoverflow || isCollection) {
      const step = (dir: number) => { const i = codesNow.indexOf(selected); selectProject(codesNow[(i + dir + codesNow.length) % codesNow.length]); };
      root.querySelector("[data-prev]")?.addEventListener("click", () => step(-1));
      root.querySelector("[data-next]")?.addEventListener("click", () => step(1));
      dotsEl?.addEventListener("click", (e) => { const d = (e.target as HTMLElement).closest("[data-dot]"); if (!d) return; const i = Array.from(dotsEl.children).indexOf(d as Element); if (i >= 0) selectProject(codesNow[i]); });
      document.addEventListener("keydown", (e) => {
        const modalOpen = !document.querySelector<HTMLElement>("[data-modal]")?.hidden || !document.querySelector<HTMLElement>("[data-req]")?.hidden;
        if (modalOpen) return;
        if (e.key === "ArrowLeft") { e.preventDefault(); step(-1); }
        else if (e.key === "ArrowRight") { e.preventDefault(); step(1); }
      });
      // Drag для cover-flow
      if (isCoverflow) {
        const cf = root.querySelector<HTMLElement>("[data-coverflow]");
        let sx = 0, dragging = false;
        cf?.addEventListener("pointerdown", (e) => { dragging = true; sx = (e as PointerEvent).clientX; });
        window.addEventListener("pointerup", (e) => { if (!dragging) return; dragging = false; const dx = (e as PointerEvent).clientX - sx; if (dx < -40) step(1); else if (dx > 40) step(-1); });
      }
    }

    // ====================== «СТОЛ АРХИТЕКТОРА» ======================
    let tableFit: (() => void) | null = null;
    if (isTable) {
      const stage = root.querySelector<HTMLElement>("[data-table]")!;
      const plane = list; const PW = 1640, PH = 1120;
      let scale = 1, panX = 0, panY = 0, vx = 0, vy = 0;
      let dragging = false, moved = 0, lastX = 0, lastY = 0, raf = 0;
      const apply = () => { plane.style.transform = `translate(${panX}px,${panY}px) scale(${scale})`; };
      const clamp = () => {
        const w = stage.clientWidth, h = stage.clientHeight;
        panX = Math.max(Math.min(0, w - PW * scale) - 140, Math.min(140, panX));
        panY = Math.max(Math.min(0, h - PH * scale) - 140, Math.min(140, panY));
      };
      const fit = () => { const w = stage.clientWidth, h = stage.clientHeight; scale = Math.min(w / PW, h / PH) * 0.98; panX = (w - PW * scale) / 2; panY = (h - PH * scale) / 2; apply(); };
      tableFit = fit;
      const focusCard = (card: HTMLElement) => {
        scale = Math.min(1.18, Math.max(0.9, (stage.clientWidth * 0.6) / card.offsetWidth));
        panX = stage.clientWidth / 2 - (card.offsetLeft + card.offsetWidth / 2) * scale;
        panY = stage.clientHeight / 2 - (card.offsetTop + card.offsetHeight / 2) * scale;
        clamp(); plane.style.transition = "transform .6s cubic-bezier(0.22,1,0.36,1)"; apply(); setTimeout(() => (plane.style.transition = ""), 640);
      };
      const inertia = () => { if (Math.abs(vx) < 0.15 && Math.abs(vy) < 0.15) return; panX += vx; panY += vy; vx *= 0.92; vy *= 0.92; clamp(); apply(); raf = requestAnimationFrame(inertia); };
      const animateZoom = (f: number) => { scale = Math.max(0.45, Math.min(1.8, scale * f)); clamp(); plane.style.transition = "transform .3s"; apply(); setTimeout(() => (plane.style.transition = ""), 300); };
      stage.addEventListener("pointerdown", (e) => { dragging = true; moved = 0; lastX = e.clientX; lastY = e.clientY; vx = vy = 0; cancelAnimationFrame(raf); plane.style.transition = ""; stage.style.cursor = "grabbing"; });
      stage.addEventListener("pointermove", (e) => { if (!dragging) return; const dx = e.clientX - lastX, dy = e.clientY - lastY; lastX = e.clientX; lastY = e.clientY; moved += Math.abs(dx) + Math.abs(dy); panX += dx; panY += dy; vx = dx; vy = dy; clamp(); apply(); });
      const endDrag = (e: PointerEvent) => {
        if (!dragging) return; dragging = false; stage.style.cursor = "grab";
        if (moved < 6) { const card = (e.target as HTMLElement).closest<HTMLElement>("[data-select]"); if (card) { const code = card.dataset.select!; if (code === selected) openModal(code); else { selectProject(code); focusCard(card); } } }
        else { raf = requestAnimationFrame(inertia); }
      };
      stage.addEventListener("pointerup", endDrag);
      stage.addEventListener("pointercancel", endDrag);
      stage.addEventListener("wheel", (e) => { e.preventDefault(); animateZoom(e.deltaY < 0 ? 1.12 : 0.89); }, { passive: false });
      root.querySelector('[data-zoom="1"]')?.addEventListener("click", () => animateZoom(1.18));
      root.querySelector('[data-zoom="-1"]')?.addEventListener("click", () => animateZoom(0.85));
