      window.addEventListener("resize", () => { clamp(); apply(); });
    }

    // ====================== ПОП-АП ======================
    const modal = document.querySelector<HTMLElement>("[data-modal]")!;
    const dialog = modal.querySelector<HTMLElement>("[data-modal-dialog]")!;
    const overlay = modal.querySelector<HTMLElement>("[data-modal-overlay]")!;
    const scroll = modal.querySelector<HTMLElement>("[data-modal-scroll]")!;
