---
import { projects, materials, type Material } from "../data/projects";

const order: Material[] = ["timber", "ceramic"];
const byMaterial = (m: Material) => projects.filter((p) => p.material === m);

// Начальное состояние — брус
const initial = byMaterial("timber");
const initFeatured = initial[0];
const initRail = initial.slice(1);

// Данные для клиентского переключения
const data = order.map((m) => ({
  id: m,
  label: materials[m].label,
  note: materials[m].note,
  items: byMaterial(m),
}));
---

<section
  id="catalog"
  class="grain relative overflow-hidden bg-ink py-24 sm:py-32"
>
  <!-- Атмосферный размытый фон, перетекает при смене материала -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img
      data-backdrop
      src={initFeatured.image}
      alt=""
      class="h-full w-full scale-110 object-cover opacity-20 blur-2xl transition-opacity duration-700"
    />
    <div class="absolute inset-0 bg-ink/70"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
      <!-- Левая колонка: опенер + переключатель -->
      <div class="flex flex-col lg:py-6">
        <p class="eyebrow text-accent-soft">Каталог проектов</p>
        <h2 class="display-lg mt-5 text-on-ink">
          Два материала,<br />одна школа.
        </h2>
        <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-on-ink/70">
          Выберите технологию — проект и атмосфера сменятся. Точные планировки
          и сметы считаем под ваш участок.
        </p>

        <!-- Переключатель: жидкое стекло -->
        <div class="mt-9">
          <div
            class="glass relative inline-flex gap-1 rounded-full p-1.5"
            role="tablist"
            aria-label="Материал дома"
            data-tablist
          >
            <span
              class="absolute left-1.5 top-1.5 z-0 rounded-full bg-accent accent-glow transition-[transform,width] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)]"
              style="height: calc(100% - 0.75rem)"
              data-indicator
              aria-hidden="true"
            >
            </span>
            {
              order.map((m, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${m}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls="catalog-stage"
                  tabindex={i === 0 ? "0" : "-1"}
                  data-tab={m}
                  class="relative z-10 rounded-full px-5 py-2.5 text-sm font-semibold text-on-ink/65 transition-colors duration-300 aria-selected:text-paper sm:px-7"
                >
                  {materials[m].label}
                </button>
              ))
            }
          </div>
          <p class="mt-4 text-sm text-on-ink/55" data-note>{materials[order[0]].note}</p>
        </div>

        <!-- Рельс остальных проектов -->
        <div
          class="mt-auto hidden gap-4 pt-10 lg:flex"
          data-rail
        >
          {
            initRail.map((p) => (
              <button
                type="button"
                data-rail-card={p.code}
                class="group w-1/2 text-left"
              >
                <span class="relative block aspect-[4/3] overflow-hidden rounded-2xl border border-white/10">
                  <img
                    src={p.image}
                    alt={p.alt}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <span class="absolute inset-0 scrim-bottom" />
                </span>
                <span class="mt-3 flex items-baseline justify-between">
                  <span class="text-sm font-medium text-on-ink">{p.name}</span>
                  <span class="tnum text-xs text-on-ink/50">{p.area} м²</span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Правая колонка: крупный проект (сцена) -->
      <figure
        id="catalog-stage"
        role="tabpanel"
        class="lift relative aspect-[4/3] overflow-hidden rounded-[28px] border border-white/10 lg:aspect-auto"
        data-stage
      >
        <img
          data-stage-img
          src={initFeatured.image}
          alt={initFeatured.alt}
          loading="lazy"
          class="h-full w-full object-cover transition-opacity duration-500"
        />
        <div class="absolute inset-0 scrim-bottom"></div>

        <!-- Код в углу -->
        <span
          class="absolute left-6 top-6 rounded-full border border-white/15 bg-ink/40 px-3.5 py-1.5 text-xs tracking-wide text-on-ink backdrop-blur-md"
          data-stage-code
        >
          {initFeatured.code}
        </span>

        <!-- Плавающая стеклянная подпись -->
        <figcaption
          class="glass hairline-top absolute bottom-6 left-6 right-6 flex flex-wrap items-end justify-between gap-4 rounded-2xl p-5 sm:left-6 sm:right-auto sm:max-w-md"
        >
          <div>
            <h3 class="font-[var(--font-display)] text-xl text-on-ink" data-stage-name>
              {initFeatured.name}
            </h3>
            <p class="mt-1 text-sm text-on-ink/60" data-stage-meta>
              {initFeatured.area} м² · {initFeatured.floors} этажа
            </p>
          </div>
          <div class="text-right">
            <p class="tnum text-sm font-semibold text-accent-soft" data-stage-price>
              {initFeatured.price}
            </p>
            <a href="#lead" class="mt-1 inline-block text-xs text-on-ink/55 underline-offset-4 transition-colors hover:text-accent hover:underline">
              Обсудить проект →
            </a>
          </div>
        </figcaption>
      </figure>

      <!-- Рельс для мобильных -->
      <div class="-mt-4 flex gap-4 overflow-x-auto no-scrollbar lg:hidden" data-rail-mobile>
        {
          initRail.map((p) => (
            <button type="button" data-rail-card={p.code} class="group min-w-[60%] shrink-0 text-left">
              <span class="relative block aspect-[4/3] overflow-hidden rounded-2xl border border-white/10">
                <img src={p.image} alt={p.alt} loading="lazy" class="h-full w-full object-cover" />
                <span class="absolute inset-0 scrim-bottom" />
              </span>
              <span class="mt-2 flex items-baseline justify-between">
                <span class="text-sm font-medium text-on-ink">{p.name}</span>
                <span class="tnum text-xs text-on-ink/50">{p.area} м²</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <script type="application/json" data-catalog set:html={JSON.stringify(data)} />
</section>

<script>
  type P = { code: string; name: string; material: string; area: number; floors: number; price: string; image: string; alt: string };
  type Group = { id: string; label: string; note: string; items: P[] };

  const root = document.querySelector<HTMLElement>("#catalog");
  if (root) {
    const groups: Group[] = JSON.parse(
      root.querySelector<HTMLElement>("[data-catalog]")!.textContent || "[]",
    );
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const indicator = root.querySelector<HTMLElement>("[data-indicator]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const backdrop = root.querySelector<HTMLImageElement>("[data-backdrop]")!;
    const stageImg = root.querySelector<HTMLImageElement>("[data-stage-img]")!;
    const stageCode = root.querySelector<HTMLElement>("[data-stage-code]")!;
    const stageName = root.querySelector<HTMLElement>("[data-stage-name]")!;
    const stageMeta = root.querySelector<HTMLElement>("[data-stage-meta]")!;
    const stagePrice = root.querySelector<HTMLElement>("[data-stage-price]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let featuredIdx = 0;

    const moveIndicator = (tab: HTMLButtonElement) => {
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.offsetLeft - 6}px)`;
    };

    const swapImg = (img: HTMLImageElement, src: string) => {
      if (reduce) { img.src = src; return; }
      img.style.opacity = "0";
      const next = new Image();
      next.onload = () => { img.src = src; img.style.opacity = ""; };
      next.src = src;
    };

    const renderRails = (g: Group) => {
      const rest = g.items.filter((_, i) => i !== featuredIdx);
      root.querySelectorAll<HTMLElement>("[data-rail], [data-rail-mobile]").forEach((rail) => {
        rail.querySelectorAll<HTMLButtonElement>("[data-rail-card]").forEach((card, i) => {
          const p = rest[i];
          if (!p) { card.style.display = "none"; return; }
          card.style.display = "";
          card.dataset.railCard = p.code;
          const img = card.querySelector("img")!;
          swapImg(img, p.image);
          img.alt = p.alt;
          const spans = card.querySelectorAll("span span");
          (spans[0] as HTMLElement).textContent = p.name;
          (spans[1] as HTMLElement).textContent = `${p.area} м²`;
          card.onclick = () => setFeatured(g, g.items.indexOf(p));
        });
      });
    };

    const setFeatured = (g: Group, idx: number) => {
      featuredIdx = idx;
      const p = g.items[idx];
      swapImg(stageImg, p.image);
      swapImg(backdrop, p.image);
      stageImg.alt = p.alt;
      stageCode.textContent = p.code;
      stageName.textContent = p.name;
      stageMeta.textContent = `${p.area} м² · ${p.floors} этажа`;
      stagePrice.textContent = p.price;
      renderRails(g);
    };

    const activate = (material: string, focus = false) => {
      const g = groups.find((x) => x.id === material)!;
      tabs.forEach((t) => {
        const sel = t.dataset.tab === material;
        t.setAttribute("aria-selected", String(sel));
        t.tabIndex = sel ? 0 : -1;
        if (sel) { moveIndicator(t); if (focus) t.focus(); }
      });
      note.style.opacity = "0";
      setTimeout(() => { note.textContent = g.note; note.style.opacity = "1"; }, reduce ? 0 : 160);
      featuredIdx = 0;
      setFeatured(g, 0);
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => activate(tab.dataset.tab!)));

    root.querySelector("[data-tablist]")!.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      let next = cur;
      if (ev.key === "ArrowRight") next = (cur + 1) % tabs.length;
      else if (ev.key === "ArrowLeft") next = (cur - 1 + tabs.length) % tabs.length;
      else if (ev.key === "Home") next = 0;
      else if (ev.key === "End") next = tabs.length - 1;
      else return;
      ev.preventDefault();
      activate(tabs[next].dataset.tab!, true);
    });

    // Привязка кликов начальных карточек рельса + позиция индикатора
    const initGroup = groups[0];
    root.querySelectorAll<HTMLButtonElement>("[data-rail-card]").forEach((card) => {
      const code = card.dataset.railCard!;
      const idx = initGroup.items.findIndex((p) => p.code === code);
      card.onclick = () => setFeatured(initGroup, idx);
    });
    const init = () => { const a = tabs.find((t) => t.getAttribute("aria-selected") === "true"); if (a) moveIndicator(a); };
    window.addEventListener("load", init);
    window.addEventListener("resize", init);
    init();
    note.style.transition = "opacity 0.3s ease";
  }
</script>
