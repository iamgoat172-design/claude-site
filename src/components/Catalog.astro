          <span class="tnum font-[var(--font-display)] text-2xl text-accent-soft">${p.price}</span>
          <div class="flex flex-wrap gap-3">
            <button type="button" data-open class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">Открыть проект</button>
            <button type="button" data-calc class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">Получить расчёт</button>
