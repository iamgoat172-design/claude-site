---
import { projects, materials, INTERIORS, DEFAULT_FEATURES, INCLUDE_STAGES, type Material } from "../data/projects";

// variant: "list" (по умолчанию) | "showcase" (кинолента)
const { variant = "list" } = Astro.props as { variant?: "list" | "showcase" };

const order: Material[] = ["timber", "ceramic"];
const byMaterial = (m: Material) => projects.filter((p) => p.material === m);

const sub: Record<Material, string> = {
  timber: "Тёплый, дышащий дом",
  ceramic: "Монолит, тишина, тепло",
};

const initList = byMaterial("timber");
const initSel = initList[0];

const payload = {
  groups: order.map((m) => ({ id: m, label: materials[m].label, note: materials[m].note, codes: byMaterial(m).map((p) => p.code) })),
  projects: Object.fromEntries(projects.map((p) => [p.code, { ...p, materialLabel: materials[p.material].label }])),
  interiors: INTERIORS,
  defaultFeatures: DEFAULT_FEATURES,
  stages: INCLUDE_STAGES,
};
---

<section id="catalog" class="grain relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img data-backdrop src={initSel.image} alt="" class="h-full w-full scale-110 object-cover opacity-20 blur-2xl transition-opacity duration-700" />
    <div class="absolute inset-0 bg-ink/72"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Каталог проектов</p>
        <h2 class="display-lg mt-5 text-on-ink">Выберите материал<br />и проект</h2>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-on-ink/65" data-note>
        {materials[order[0]].note}. Переключайте проекты справа, открывайте
        карточку — внутри визуализации, интерьеры и планировки.
      </p>
    </div>

    <div class="glass relative mt-9 grid w-full max-w-2xl grid-cols-2 gap-1.5 rounded-2xl p-1.5" role="tablist" aria-label="Материал дома" data-tablist>
      <span class="pointer-events-none absolute left-1.5 top-1.5 z-0 rounded-xl bg-accent accent-glow transition-[transform,width] duration-[450ms] ease-[cubic-bezier(0.34,1.56,0.4,1)]" style="height: calc(100% - 0.75rem)" data-indicator aria-hidden="true"></span>
      {
        order.map((m, i) => (
          <button type="button" role="tab" id={`tab-${m}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? "0" : "-1"} data-tab={m} class="group relative z-10 rounded-xl px-5 py-3 text-left transition-colors duration-300">
            <span class="flex items-center gap-2">
              <span class={`h-2 w-2 rounded-full ${m === "timber" ? "bg-[#c8a578]" : "bg-[#b9876a]"} ring-2 ring-white/20`} />
              <span class="block font-[var(--font-display)] text-base text-on-ink/70 transition-colors group-aria-selected:text-paper sm:text-lg">{materials[m].label}</span>
            </span>
            <span class="mt-1 block pl-4 text-xs text-on-ink/45 transition-colors group-aria-selected:text-paper/70">{sub[m]}</span>
          </button>
        ))
      }
    </div>

    {variant === "list" && (
    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[8fr_4fr]">
      <!-- Выбранный дом -->
      <div class="flex flex-col gap-4">
        <button type="button" data-open class="lift group relative block aspect-[16/10] w-full overflow-hidden rounded-[28px] border border-white/10 text-left">
          <img data-sel-img src={initSel.image} alt={initSel.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/55 to-transparent"></div>
          <span class="absolute left-6 top-6 rounded-full border border-white/15 bg-ink/40 px-3.5 py-1.5 text-xs tracking-wide text-on-ink backdrop-blur-md" data-sel-code>{initSel.code}</span>
          <span class="absolute right-6 top-6 flex items-center gap-2 rounded-full bg-accent/90 px-4 py-1.5 text-xs font-semibold text-paper opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            Открыть проект
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>

        <div class="glass hairline-top rounded-[24px] p-6 sm:p-7">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h3 class="font-[var(--font-display)] text-2xl text-on-ink sm:text-3xl" data-sel-name>{initSel.name}</h3>
              <p class="mt-2 text-sm text-on-ink/60" data-sel-meta>{initSel.area} м² · {initSel.floors} этажа</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-on-ink/45">Стоимость</p>
              <p class="tnum font-[var(--font-display)] text-2xl text-accent-soft" data-sel-price>{initSel.price}</p>
            </div>
          </div>
          <p class="mt-4 border-t border-white/10 pt-4 text-sm text-on-ink/65" data-sel-summary>{initSel.summary}</p>
          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button type="button" data-open class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
              Открыть проект
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" data-calc class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors duration-300 hover:border-accent hover:text-accent">Получить расчёт</button>
          </div>
        </div>
      </div>

      <!-- Список проектов -->
      <div class="no-scrollbar flex flex-col gap-3 lg:max-h-[680px] lg:overflow-y-auto lg:pr-1" data-list role="listbox" aria-label="Проекты">
        {
          initList.map((p, i) => (
            <button type="button" data-select={p.code} role="option" aria-selected={i === 0 ? "true" : "false"} class="group relative block aspect-[16/10] w-full shrink-0 overflow-hidden rounded-[20px] border text-left transition-all duration-300 aria-selected:border-accent/70 border-white/10 hover:border-white/30">
              <img src={p.image} alt={p.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[800ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105 group-aria-selected:scale-[1.03]" />
              <span class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></span>
              <span class="absolute left-3 top-3 flex items-center gap-2">
                <span class="rounded-full border border-white/20 bg-ink/40 px-2.5 py-1 text-[10px] tracking-wide text-on-ink backdrop-blur-md">{p.code}</span>
                {p.tag && <span class="rounded-full bg-accent/90 px-2.5 py-1 text-[10px] font-semibold text-paper">{p.tag}</span>}
              </span>
              <span class="absolute right-3 top-3 grid h-7 w-7 place-items-center rounded-full bg-accent text-paper opacity-0 transition-opacity duration-300 group-aria-selected:opacity-100" aria-hidden="true"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="absolute inset-x-0 bottom-0 p-4">
                <span class="flex items-center justify-between gap-2">
                  <span class="font-[var(--font-display)] text-lg text-on-ink">{p.name}</span>
                  <span class="tnum text-xs text-on-ink/70">{p.area} м²</span>
                </span>
                <span class="mt-1 block text-xs text-accent-soft">{p.hook}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
    )}

    {variant === "showcase" && (
    <div class="mt-8">
      <!-- Сцена -->
      <div class="group relative aspect-[4/3] w-full overflow-hidden rounded-[28px] border border-white/10 sm:aspect-[16/9] lg:aspect-[21/9]" data-stage>
        <img data-sel-img src={initSel.image} alt={initSel.alt} class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/35 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-ink/75 via-ink/10 to-transparent"></div>

        <div class="absolute inset-x-0 top-0 flex items-center justify-between p-5 sm:p-7">
          <span class="flex items-center gap-2">
            <span class="rounded-full border border-white/20 bg-ink/40 px-3 py-1 text-xs tracking-wide text-on-ink backdrop-blur-md" data-sel-code>{initSel.code}</span>
            <span class="rounded-full bg-accent/90 px-3 py-1 text-xs font-semibold text-paper" data-sel-tag>{initSel.tag}</span>
          </span>
          <span class="tnum rounded-full bg-ink/40 px-3 py-1 text-xs text-on-ink/85 backdrop-blur-md" data-counter></span>
        </div>

        <button type="button" data-prev aria-label="Предыдущий проект" class="absolute left-4 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" data-next aria-label="Следующий проект" class="absolute right-4 top-1/2 z-10 grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-9 lg:max-w-2xl">
          <p class="eyebrow text-accent-soft" data-sel-hook>{initSel.hook}</p>
          <h3 class="display-lg mt-3 text-on-ink" data-sel-name>{initSel.name}</h3>
          <p class="mt-3 text-on-ink/75" data-sel-meta>{initSel.area} м² · {initSel.floors} этажа</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
            <span class="tnum font-[var(--font-display)] text-2xl text-accent-soft" data-sel-price>{initSel.price}</span>
            <div class="flex flex-wrap gap-3">
              <button type="button" data-open class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
                Открыть проект
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button type="button" data-calc class="inline-flex items-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors duration-300 hover:border-accent hover:text-accent">Получить расчёт</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Кинолента -->
      <div class="no-scrollbar mt-4 flex gap-3 overflow-x-auto pb-1" data-list role="listbox" aria-label="Проекты">
        {
          initList.map((p, i) => (
            <button type="button" data-select={p.code} role="option" aria-selected={i === 0 ? "true" : "false"} class="group relative aspect-[4/3] w-40 shrink-0 overflow-hidden rounded-2xl border text-left transition-all duration-300 aria-selected:border-accent/70 border-white/10 hover:border-white/30 sm:w-48">
              <img src={p.image} alt={p.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 group-aria-selected:scale-[1.04]" />
              <span class="absolute inset-0 bg-gradient-to-t from-ink/90 to-transparent opacity-80 transition-opacity group-aria-selected:opacity-100"></span>
              <span class="absolute left-2 top-2 rounded-full bg-ink/50 px-2 py-0.5 text-[10px] text-on-ink/80 backdrop-blur-md">{p.code}</span>
              <span class="absolute inset-x-0 bottom-0 p-2.5">
                <span class="block truncate font-[var(--font-display)] text-sm text-on-ink">{p.name}</span>
                <span class="tnum text-[11px] text-on-ink/60">{p.area} м²</span>
              </span>
            </button>
          ))
        }
      </div>
      <div class="mt-4 flex justify-center gap-2" data-dots aria-hidden="true"></div>
    </div>
    )}

    {variant === "coverflow" && (
    <div class="mt-8" data-coverflow>
      <div class="relative">
        <div class="relative mx-auto h-[clamp(460px,66vh,660px)] [perspective:1800px]">
          <div class="relative h-full w-full [transform-style:preserve-3d]" data-list role="listbox" aria-label="Проекты"></div>
        </div>
        <button type="button" data-prev aria-label="Предыдущий проект" class="absolute left-2 top-1/2 z-[60] grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent sm:left-6">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" data-next aria-label="Следующий проект" class="absolute right-2 top-1/2 z-[60] grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full border border-white/20 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent sm:right-6">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="mt-8 flex justify-center gap-2" data-dots aria-hidden="true"></div>
    </div>
    )}

    {variant === "spread" && (
    <div class="mt-8">
      <div class="no-scrollbar h-[82vh] snap-y snap-mandatory overflow-y-auto rounded-[28px] border border-white/10" data-list data-spread role="listbox" aria-label="Проекты"></div>
      <p class="mt-3 text-center text-xs text-on-ink/40">Листайте вниз — проекты сменяют друг друга</p>
    </div>
    )}

    {variant === "collection" && (
    <div class="mt-8" data-collection>
      <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[28px] border border-white/10 sm:aspect-[16/10] lg:aspect-[16/8]">
        <img data-img-a src={initSel.image} alt={initSel.alt} class="kenburns absolute inset-0 h-full w-full object-cover" style="opacity:1" />
        <img data-img-b src="" alt="" class="kenburns absolute inset-0 h-full w-full object-cover" style="opacity:0" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/30 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-ink/70 via-transparent to-transparent"></div>

        <div class="absolute inset-x-0 bottom-0 p-6 sm:p-10 lg:max-w-2xl">
          <p class="eyebrow text-on-ink/55"><span data-counter>01 / 05</span> · Коллекция</p>
          <h3 class="display-xl mt-3 text-on-ink" data-sel-name>{initSel.name}</h3>
          <span class="mt-4 block h-px w-16 bg-accent"></span>
          <p class="mt-4 text-lg text-on-ink/75" data-sel-essence>{initSel.hook}</p>
          <div class="mt-6 flex flex-wrap items-end gap-x-8 gap-y-3" data-sel-meta-wrap></div>
          <div class="mt-8 flex flex-wrap items-center gap-6">
            <span class="tnum font-[var(--font-display)] text-2xl text-accent-soft" data-sel-price>{initSel.price}</span>
            <button type="button" data-open class="group inline-flex items-center gap-2 text-sm font-semibold text-on-ink">
              Смотреть проект <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </button>
            <button type="button" data-calc class="text-sm text-on-ink/55 underline-offset-4 transition-colors hover:text-accent hover:underline">Запросить смету</button>
          </div>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-px bg-white/10"><div class="h-full bg-accent transition-[width] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]" data-progress style="width:20%"></div></div>
      </div>

      <!-- Типографский индекс коллекции -->
      <div class="mt-8 border-t border-white/10" data-list role="listbox" aria-label="Проекты"></div>
    </div>
    )}

    {variant === "table" && (
    <div class="mt-8">
      <div data-table class="relative h-[68vh] min-h-[460px] cursor-grab touch-none select-none overflow-hidden rounded-[28px] border border-white/10 bg-ink">
        <div class="pointer-events-none absolute inset-0 opacity-60" style="background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:46px 46px"></div>
        <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(120% 120% at 50% 28%, transparent 42%, rgba(20,22,27,.6))"></div>
        <div data-list data-plane class="absolute left-0 top-0 origin-top-left will-change-transform" style="width:1640px;height:1120px"></div>
        <div class="pointer-events-none absolute left-5 top-5 flex items-center gap-2 text-xs text-on-ink/45">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 9l-2 3 2 3M19 9l2 3-2 3M9 5l3-2 3 2M9 19l3 2 3-2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Перетаскивайте · колесо — масштаб · клик — проект
        </div>
        <div class="absolute bottom-5 right-5 flex flex-col gap-2">
          <button type="button" data-zoom="1" aria-label="Приблизить" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent">+</button>
          <button type="button" data-zoom="-1" aria-label="Отдалить" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent">−</button>
          <button type="button" data-fit aria-label="Показать все" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink/50 text-on-ink backdrop-blur-md transition-colors hover:border-accent hover:text-accent"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>

      <div class="glass hairline-top mt-4 flex flex-wrap items-center justify-between gap-4 rounded-[24px] p-5">
        <div class="flex items-center gap-4">
          <img data-sel-img src={initSel.image} alt="" class="h-14 w-20 shrink-0 rounded-lg object-cover" />
          <div>
            <span class="block text-[11px] tracking-wide text-on-ink/45"><span data-sel-code>{initSel.code}</span> · <span data-sel-tag>{initSel.tag}</span></span>
            <span class="block font-[var(--font-display)] text-lg text-on-ink" data-sel-name>{initSel.name}</span>
            <span class="block text-xs text-on-ink/55" data-sel-meta>{initSel.area} м² · {initSel.floors} этажа</span>
          </div>
        </div>
        <div class="flex items-center gap-5">
          <span class="tnum font-[var(--font-display)] text-xl text-accent-soft" data-sel-price>{initSel.price}</span>
          <button type="button" data-open class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">Открыть проект</button>
          <button type="button" data-calc class="hidden rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent sm:inline-flex">Расчёт</button>
        </div>
      </div>
    </div>
    )}
  </div>

  <script type="application/json" data-catalog set:html={JSON.stringify(payload)} />
</section>

<!-- ПОП-АП ПРОЕКТА -->
<div data-modal hidden class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-6">
  <div data-modal-overlay class="absolute inset-0 bg-ink/85 opacity-0 backdrop-blur-md transition-opacity duration-300"></div>
  <div role="dialog" aria-modal="true" aria-labelledby="modal-title" class="glass hairline-top relative flex max-h-[94dvh] w-full max-w-5xl translate-y-4 flex-col overflow-hidden rounded-[28px] opacity-0 transition-all duration-300" data-modal-dialog>

    <!-- Sticky bar -->
    <div class="sticky top-0 z-20 flex items-center justify-between gap-4 border-b border-white/10 bg-ink/65 px-5 py-3 backdrop-blur-xl sm:px-7">
      <div class="flex min-w-0 items-center gap-3">
        <span data-modal-code class="shrink-0 rounded-full border border-white/15 px-3 py-1 text-xs tracking-wide text-on-ink/80"></span>
        <span data-modal-name-sm class="truncate font-[var(--font-display)] text-on-ink"></span>
      </div>
      <button type="button" data-modal-close aria-label="Закрыть" class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/15 bg-ink/40 text-on-ink transition-colors hover:border-accent hover:text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Scroll body -->
    <div data-modal-scroll class="scrollbar-brand min-h-0 flex-1 overflow-y-auto">
      <!-- Hero -->
      <div class="relative aspect-[16/9] w-full">
        <img data-modal-hero src="" alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-9">
          <span data-modal-material class="eyebrow text-accent-soft"></span>
          <h3 id="modal-title" data-modal-name class="display-lg mt-3 text-on-ink"></h3>
          <p data-modal-meta class="mt-3 text-on-ink/70"></p>
        </div>
      </div>

      <div class="space-y-12 p-6 sm:space-y-14 sm:p-9">
        <!-- Цена + summary + CTA -->
        <div class="flex flex-wrap items-end justify-between gap-6 border-b border-white/10 pb-9">
          <div>
            <p class="text-xs text-on-ink/45">Стоимость</p>
            <p data-modal-price class="tnum mt-1 font-[var(--font-display)] text-3xl text-accent-soft"></p>
            <p data-modal-summary class="mt-2 text-sm text-on-ink/60"></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" data-modal-cta="smeta" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Скачать смету
            </button>
            <button type="button" data-modal-cta="presentation" class="inline-flex items-center justify-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors duration-300 hover:border-accent hover:text-accent">Презентация</button>
          </div>
        </div>

        <!-- Что входит в стоимость — этапы (табы) -->
        <section>
          <h4 class="eyebrow text-on-ink/40">Что входит в стоимость</h4>
          <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-on-ink/60">
            Полный цикл — от проекта до сборки на участке. Точный состав
            фиксируется в смете и договоре.
          </p>
          <div data-stages-tabs class="no-scrollbar mt-6 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Этапы"></div>
          <div data-stages-panel class="mt-5"></div>
        </section>

        <!-- О проекте -->
        <section>
          <h4 class="eyebrow text-on-ink/40">О проекте</h4>
          <div data-modal-desc class="mt-5 max-w-2xl space-y-4 text-base leading-relaxed text-on-ink/75 sm:text-lg"></div>
          <ul data-modal-feats class="mt-6 flex flex-wrap gap-2"></ul>
        </section>

        <!-- Характеристики -->
        <section>
          <h4 class="eyebrow text-on-ink/40">Характеристики</h4>
          <dl data-modal-specs class="mt-5 grid gap-x-10 sm:grid-cols-2"></dl>
        </section>

        <!-- Визуализации -->
        <section data-modal-vis-wrap>
          <h4 class="eyebrow text-on-ink/40">Визуализации</h4>
          <div data-modal-vis class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2"></div>
        </section>

        <!-- Интерьеры -->
        <section data-modal-int-wrap>
          <h4 class="eyebrow text-on-ink/40">Интерьеры</h4>
          <div data-modal-int class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2"></div>
        </section>

        <!-- Планировки -->
        <section data-modal-plans-wrap>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h4 class="eyebrow text-on-ink/40">Планировки</h4>
            <button type="button" data-plan-change class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-xs font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4z" stroke-linejoin="round"/></svg>
              Поменять планировку
            </button>
          </div>
          <div data-modal-plan-tabs class="mt-5 flex gap-2"></div>
          <div class="mt-3 overflow-hidden rounded-2xl border border-white/10 bg-paper">
            <img data-modal-plan-img src="" alt="" class="mx-auto w-full max-w-3xl object-contain" />
          </div>
        </section>
        <section data-modal-plans-empty hidden>
          <h4 class="eyebrow text-on-ink/40">Планировки</h4>
          <p class="mt-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 text-sm text-on-ink/55">Планировки по этому проекту пришлём по запросу — вместе со сметой.</p>
        </section>

        <!-- Видеообзор дома -->
        <section data-modal-video-wrap>
          <h4 class="eyebrow text-on-ink/40">Видеообзор дома</h4>
          <!-- Реальное видео (фасад → плеер по клику) -->
          <figure data-modal-video-real hidden class="group relative mt-5 aspect-video overflow-hidden rounded-2xl border border-white/10 bg-ink-2">
            <img data-modal-video-poster src="" alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]" />
            <div class="absolute inset-0 bg-ink/35"></div>
            <button type="button" data-modal-video-play aria-label="Смотреть видеообзор дома" class="absolute inset-0 z-10 grid place-items-center">
              <span class="grid h-16 w-16 place-items-center rounded-full border border-white/25 bg-white/10 backdrop-blur-md transition-transform duration-300 group-hover:scale-105">
                <svg class="ml-1 h-6 w-6 text-on-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </button>
          </figure>
          <!-- Заглушка, если видео нет -->
          <div data-modal-video-stub hidden class="relative mt-5 grid aspect-video place-items-center overflow-hidden rounded-2xl border border-white/10">
            <img data-modal-video-bg src="" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30 blur-[2px]" />
            <div class="absolute inset-0 bg-ink/55"></div>
            <div class="relative z-10 text-center">
              <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-white/25 bg-white/10 backdrop-blur-md transition-transform duration-300 hover:scale-105">
                <svg class="ml-1 h-6 w-6 text-on-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <p class="mt-4 text-sm text-on-ink/70">Видеообзор готовим</p>
              <button type="button" data-modal-cta="video" class="mt-3 text-sm font-semibold text-accent-soft underline-offset-4 hover:underline">Запросить видеообзор →</button>
            </div>
          </div>
        </section>

        <!-- Финальный CTA -->
        <div class="accent-glow rounded-3xl border border-accent/30 bg-accent/[0.06] p-7 text-center sm:p-9">
          <p class="font-[var(--font-display)] text-2xl text-on-ink">Понравился проект?</p>
          <p data-modal-final class="mx-auto mt-2 max-w-md text-sm text-on-ink/65"></p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <button type="button" data-modal-cta="smeta" class="rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">Скачать смету</button>
            <button type="button" data-modal-cta="presentation" class="rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">Получить презентацию</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ПОП-АП ЗАЯВКИ (смета / презентация / видео / расчёт) -->
<div data-req hidden class="fixed inset-0 z-[110] flex items-center justify-center p-3 sm:p-6">
  <div data-req-overlay class="absolute inset-0 bg-ink/85 opacity-0 backdrop-blur-md transition-opacity duration-300"></div>
  <div role="dialog" aria-modal="true" aria-labelledby="req-title" class="glass hairline-top relative grid max-h-[94dvh] w-full max-w-3xl translate-y-4 grid-cols-1 overflow-hidden rounded-[28px] opacity-0 transition-all duration-300 lg:grid-cols-2" data-req-dialog>

    <!-- Левая визуальная панель -->
    <div class="relative hidden overflow-hidden bg-ink-2 lg:block">
      <img data-req-img src="" alt="" class="absolute inset-0 h-full w-full object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30"></div>
      <div class="relative z-10 flex h-full flex-col justify-between p-8">
        <span class="eyebrow text-accent-soft">Вологодское Зодчество</span>
        <div>
          <p class="font-[var(--font-display)] text-2xl text-on-ink">Что вы получите</p>
          <ul class="mt-5 space-y-3">
            {
              [
                "Смету по проекту (PDF)",
                "Планировки этажей",
                "Презентацию проекта",
                "Консультацию архитектора",
              ].map((t) => (
                <li class="flex items-baseline gap-2.5 text-sm text-on-ink/85">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {t}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-xs text-on-ink/40">Ответим в течение 15 минут в удобном вам канале.</p>
        </div>
      </div>
    </div>

    <!-- Форма -->
    <div class="scrollbar-brand flex min-h-0 flex-col overflow-y-auto p-7 sm:p-9">
      <button type="button" data-req-close aria-label="Закрыть" class="absolute right-4 top-4 z-20 grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink/40 text-on-ink transition-colors hover:border-accent hover:text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>

      <!-- Состояние: форма -->
      <div data-req-formwrap>
        <p data-req-kind class="eyebrow text-accent-soft"></p>
        <h3 id="req-title" data-req-title class="mt-3 font-[var(--font-display)] text-2xl text-on-ink sm:text-3xl"></h3>
        <p data-req-sub class="mt-2 text-sm text-on-ink/55"></p>

        <form class="mt-7 space-y-5" data-req-form novalidate>
          <div>
            <label for="rq-name" class="block text-sm font-medium text-on-ink">Имя <span class="text-accent">*</span></label>
            <input id="rq-name" name="name" type="text" autocomplete="name" required class="mt-2 w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-on-ink placeholder:text-on-ink/35 focus:border-accent focus:outline-none" placeholder="Как к вам обращаться" />
            <p class="mt-1.5 hidden text-sm text-red-300" data-rq-error="name" role="alert"></p>
          </div>

          <div>
            <label for="rq-phone" class="block text-sm font-medium text-on-ink">Телефон <span class="text-accent">*</span></label>
            <input id="rq-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required class="mt-2 w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-on-ink placeholder:text-on-ink/35 focus:border-accent focus:outline-none" placeholder="+7 (___) ___-__-__" data-req-phone />
            <p class="mt-1.5 hidden text-sm text-red-300" data-rq-error="phone" role="alert"></p>
          </div>

          <!-- Способ связи -->
          <fieldset>
            <legend class="block text-sm font-medium text-on-ink">Куда вам удобнее ответить</legend>
            <div class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label="Способ связи" data-req-methods>
              {
                [
                  { id: "telegram", label: "Telegram", icon: '<path d="M22 4 11 13M22 4l-7 17-4-8-8-4 19-5z" stroke-linecap="round" stroke-linejoin="round"/>' },
                  { id: "max", label: "МАКС", icon: '<path d="M4 5h16v11H8l-4 4z" stroke-linecap="round" stroke-linejoin="round"/>' },
                  { id: "phone", label: "Телефон", icon: '<path d="M5 4h4l2 5-3 2a12 12 0 005 5l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round"/>' },
                ].map((m, i) => (
                  <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-method={m.id} class="group flex flex-col items-center gap-1.5 rounded-xl border px-3 py-3 text-xs font-medium transition-colors aria-checked:border-accent aria-checked:bg-accent/10 aria-checked:text-accent-soft border-white/15 bg-white/[0.03] text-on-ink/65 hover:border-white/30">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={m.icon} />
                    {m.label}
                  </button>
                ))
              }
            </div>
          </fieldset>

          <!-- Ник в Telegram (только при выборе Telegram, необязательно) -->
          <div data-req-tg hidden>
            <label for="rq-tg" class="block text-sm font-medium text-on-ink">Ник в Telegram <span class="text-on-ink/40">(необязательно)</span></label>
            <input id="rq-tg" name="telegram" type="text" class="mt-2 w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-on-ink placeholder:text-on-ink/35 focus:border-accent focus:outline-none" placeholder="@username" />
          </div>

          <label class="flex items-start gap-3 text-sm text-on-ink/60">
            <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#B0885A]" />
            <span>Согласен на обработку персональных данных и <a href="/privacy" target="_blank" rel="noopener" class="text-accent-soft underline underline-offset-2">политику конфиденциальности</a>.</span>
          </label>
          <p class="hidden text-sm text-red-300" data-rq-error="consent" role="alert"></p>

          <button type="submit" data-req-submit class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-4 text-base font-semibold text-paper transition-transform duration-300 hover:scale-[1.02] disabled:opacity-60">
            <span data-req-submit-label>Отправить</span>
            <svg class="hidden h-5 w-5 animate-spin" data-req-spinner viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.3"/><path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
          </button>
          <p class="text-center text-xs text-on-ink/40">Это бесплатно и ни к чему не обязывает.</p>
        </form>
      </div>

      <!-- Состояние: успех -->
      <div data-req-success hidden class="flex flex-col items-center justify-center py-10 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-full border border-accent/40 text-accent accent-glow">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3 class="mt-5 font-[var(--font-display)] text-2xl text-on-ink">Заявка принята</h3>
        <p data-req-success-text class="mt-3 max-w-xs text-sm text-on-ink/60"></p>
        <button type="button" data-req-close class="mt-7 rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">Закрыть</button>
      </div>
    </div>
  </div>
</div>

<script>
  type Spec = { label: string; value: string };
  type Plan = { floor: string; src: string };
  type Img = { src: string; alt: string };
  type P = { code: string; name: string; material: string; materialLabel: string; area: number; floors: number; price: string; image: string; alt: string; description: string; summary: string; hook: string; tag?: string; specs: Spec[]; longDescription?: string[]; features?: string[]; gallery?: Img[]; plans?: Plan[]; video?: string };
  type Stage = { label: string; icon: string; heading: string; items: { t: string; d: string }[]; badge?: string; photo?: string; photoCeramic?: string; photoTimber?: string };
  type Payload = { groups: { id: string; label: string; note: string; codes: string[] }[]; projects: Record<string, P>; interiors: Img[]; defaultFeatures: string[]; stages: Stage[] };

  const root = document.querySelector<HTMLElement>("#catalog");
  if (root) {
    const data: Payload = JSON.parse(root.querySelector<HTMLElement>("[data-catalog]")!.textContent || "{}");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const indicator = root.querySelector<HTMLElement>("[data-indicator]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const backdrop = root.querySelector<HTMLImageElement>("[data-backdrop]")!;
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const selImg = root.querySelector<HTMLImageElement>("[data-sel-img]")!;
    let selected = data.groups[0].codes[0];

    const setText = (sel: string, scope: ParentNode, val: string) => { const el = scope.querySelector<HTMLElement>(sel); if (el) el.textContent = val; };
    const swapImg = (img: HTMLImageElement | null, src: string) => {
      if (!img) return;
      if (reduce) { img.src = src; return; }
      img.style.opacity = "0";
      const n = new Image(); n.onload = () => { img.src = src; img.style.opacity = ""; }; n.src = src;
    };
    const moveIndicator = (tab: HTMLButtonElement) => { indicator.style.width = `${tab.offsetWidth}px`; indicator.style.transform = `translateX(${tab.offsetLeft - 6}px)`; };
    const canHover = window.matchMedia("(hover: hover)").matches;
    const isShowcase = !!root.querySelector("[data-stage]");
    const isCoverflow = !!root.querySelector("[data-coverflow]");
    const isSpread = !!root.querySelector("[data-spread]");
    const isCollection = !!root.querySelector("[data-collection]");
    const isTable = !!root.querySelector("[data-table]");
    const counterEl = root.querySelector<HTMLElement>("[data-counter]");
    const progressEl = root.querySelector<HTMLElement>("[data-progress]");
    const metaWrap = root.querySelector<HTMLElement>("[data-sel-meta-wrap]");
    const imgA = root.querySelector<HTMLImageElement>("[data-img-a]");
    const imgB = root.querySelector<HTMLImageElement>("[data-img-b]");
    let topA = true;
    const crossfade = (src: string) => {
      if (!imgA || !imgB) return;
      if (reduce) { (topA ? imgA : imgB).src = src; return; }
      const incoming = topA ? imgB : imgA, outgoing = topA ? imgA : imgB;
      const pre = new Image();
      pre.onload = () => {
        incoming.src = src;
        incoming.classList.remove("kenburns"); void incoming.offsetWidth; incoming.classList.add("kenburns");
        incoming.style.opacity = "1"; outgoing.style.opacity = "0";
        topA = !topA;
      };
      pre.src = src;
    };
    const dotsEl = root.querySelector<HTMLElement>("[data-dots]");
    const selTag = root.querySelector<HTMLElement>("[data-sel-tag]");
    let codesNow: string[] = data.groups[0].codes;

    // Применить кадр/инфо выбранного (без смены состояния выбора) — для предпросмотра
    const applyFeatured = (code: string) => {
      const p = data.projects[code]; if (!p) return;
      if (isCollection) {
        crossfade(p.image);
        setText("[data-sel-name]", root, p.name);
        setText("[data-sel-essence]", root, p.hook);
        setText("[data-sel-price]", root, p.price);
        if (metaWrap) metaWrap.innerHTML = [["Площадь", `${p.area} м²`], ["Этажей", String(p.floors)], ["Материал", p.materialLabel]].map(([l, v]) => `<span class="flex flex-col gap-1 border-l border-white/15 pl-4"><span class="text-[11px] uppercase tracking-[0.16em] text-on-ink/40">${l}</span><span class="tnum font-[var(--font-display)] text-lg text-on-ink">${v}</span></span>`).join("");
        return;
      }
      if (selImg) { swapImg(selImg, p.image); selImg.alt = p.alt; }
      swapImg(backdrop, p.image);
      setText("[data-sel-code]", root, p.code);
      setText("[data-sel-name]", root, p.name);
      setText("[data-sel-hook]", root, p.hook);
      setText("[data-sel-meta]", root, `${p.area} м² · ${p.floors} этажа`);
      setText("[data-sel-summary]", root, p.summary);
      setText("[data-sel-price]", root, p.price);
      const chipsEl = root.querySelector<HTMLElement>("[data-sel-chips]");
      if (chipsEl) chipsEl.innerHTML = (p.specs || []).slice(0, 4).map((s) => `<span class="rounded-full border border-white/12 bg-white/[0.03] px-3 py-1 text-xs text-on-ink/75">${s.label} · ${s.value}</span>`).join("");
      if (selTag) { selTag.textContent = p.tag || ""; selTag.hidden = !p.tag; }
    };
    const updateNav = (code: string) => {
      const idx = codesNow.indexOf(code); if (idx < 0) return;
      if (counterEl) counterEl.textContent = `${String(idx + 1).padStart(2, "0")} / ${String(codesNow.length).padStart(2, "0")}`;
      if (progressEl) progressEl.style.width = `${((idx + 1) / codesNow.length) * 100}%`;
      if (dotsEl) dotsEl.querySelectorAll<HTMLElement>("[data-dot]").forEach((d, i) => {
        const on = i === idx;
        d.className = `h-1.5 rounded-full transition-all duration-300 ${on ? "w-6 bg-accent" : "w-1.5 bg-white/25 hover:bg-white/50"}`;
      });
    };
    const layoutCover = (center: number) => {
      const cards = Array.from(list.querySelectorAll<HTMLElement>("[data-select]"));
      const n = cards.length;
      cards.forEach((card, i) => {
        // Циклическое смещение — карусель «бесконечная»: соседи заворачиваются по кругу
        let off = i - center;
        if (n > 2) { if (off > n / 2) off -= n; else if (off < -n / 2) off += n; }
        const a = Math.abs(off);
        card.style.transform = `translate(-50%,-50%) translateX(${off * 50}%) translateZ(${-a * 230}px) rotateY(${off * -30}deg) scale(${off === 0 ? 1 : 0.82})`;
        card.style.opacity = a > 2 ? "0" : a === 0 ? "1" : a === 1 ? "0.95" : "0.78";
        card.style.zIndex = String(100 - a);
        card.style.pointerEvents = a > 2 ? "none" : "auto";
