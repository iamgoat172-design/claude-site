    // Раскладка карточек на «столе» (px в плоскости 1640×1120)
    const slots = [
      { x: 70, y: 90, w: 540 }, { x: 700, y: 60, w: 430 }, { x: 1180, y: 150, w: 380 },
      { x: 150, y: 580, w: 450 }, { x: 690, y: 560, w: 500 }, { x: 1230, y: 620, w: 360 },
