---
import { projects, materials, INTERIORS, DEFAULT_FEATURES, type Material } from "../data/projects";

const order: Material[] = ["timber", "ceramic"];
const byMaterial = (m: Material) => projects.filter((p) => p.material === m);

const sub: Record<Material, string> = {
  timber: "Тёплый, дышащий дом",
  ceramic: "Монолит, тишина, тепло",
};

const initList = byMaterial("timber");
const initSel = initList[0];

const payload = {
  groups: order.map((m) => ({ id: m, label: materials[m].label, note: materials[m].note, codes: byMaterial(m).map((p) => p.code) })),
  projects: Object.fromEntries(projects.map((p) => [p.code, { ...p, materialLabel: materials[p.material].label }])),
  interiors: INTERIORS,
  defaultFeatures: DEFAULT_FEATURES,
};
---

<section id="catalog" class="grain relative overflow-hidden bg-ink py-20 sm:py-28">
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img data-backdrop src={initSel.image} alt="" class="h-full w-full scale-110 object-cover opacity-20 blur-2xl transition-opacity duration-700" />
    <div class="absolute inset-0 bg-ink/72"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1400px] px-5 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow text-accent-soft">Каталог проектов</p>
        <h2 class="display-lg mt-5 text-on-ink">Выберите материал<br />и проект</h2>
      </div>
      <p class="max-w-sm text-[15px] leading-relaxed text-on-ink/65" data-note>
        {materials[order[0]].note}. Переключайте проекты справа, открывайте
        карточку — внутри визуализации, интерьеры и планировки.
      </p>
    </div>

    <div class="glass relative mt-9 grid w-full max-w-2xl grid-cols-2 gap-1.5 rounded-2xl p-1.5" role="tablist" aria-label="Материал дома" data-tablist>
      <span class="pointer-events-none absolute left-1.5 top-1.5 z-0 rounded-xl bg-accent accent-glow transition-[transform,width] duration-[450ms] ease-[cubic-bezier(0.34,1.56,0.4,1)]" style="height: calc(100% - 0.75rem)" data-indicator aria-hidden="true"></span>
      {
        order.map((m, i) => (
          <button type="button" role="tab" id={`tab-${m}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? "0" : "-1"} data-tab={m} class="group relative z-10 rounded-xl px-5 py-3 text-left transition-colors duration-300">
            <span class="flex items-center gap-2">
              <span class={`h-2 w-2 rounded-full ${m === "timber" ? "bg-[#c8a578]" : "bg-[#b9876a]"} ring-2 ring-white/20`} />
              <span class="block font-[var(--font-display)] text-base text-on-ink/70 transition-colors group-aria-selected:text-paper sm:text-lg">{materials[m].label}</span>
            </span>
            <span class="mt-1 block pl-4 text-xs text-on-ink/45 transition-colors group-aria-selected:text-paper/70">{sub[m]}</span>
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[8fr_4fr]">
      <!-- Выбранный дом -->
      <div class="flex flex-col gap-4">
        <button type="button" data-open class="lift group relative block aspect-[16/10] w-full overflow-hidden rounded-[28px] border border-white/10 text-left">
          <img data-sel-img src={initSel.image} alt={initSel.alt} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/55 to-transparent"></div>
          <span class="absolute left-6 top-6 rounded-full border border-white/15 bg-ink/40 px-3.5 py-1.5 text-xs tracking-wide text-on-ink backdrop-blur-md" data-sel-code>{initSel.code}</span>
          <span class="absolute right-6 top-6 flex items-center gap-2 rounded-full bg-accent/90 px-4 py-1.5 text-xs font-semibold text-paper opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            Открыть проект
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>

        <div class="glass hairline-top rounded-[24px] p-6 sm:p-7">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <h3 class="font-[var(--font-display)] text-2xl text-on-ink sm:text-3xl" data-sel-name>{initSel.name}</h3>
              <p class="mt-2 text-sm text-on-ink/60" data-sel-meta>{initSel.area} м² · {initSel.floors} этажа</p>
            </div>
            <div class="text-right">
              <p class="text-xs text-on-ink/45">Стоимость под ключ</p>
              <p class="tnum font-[var(--font-display)] text-2xl text-accent-soft" data-sel-price>{initSel.price}</p>
            </div>
          </div>
          <p class="mt-4 border-t border-white/10 pt-4 text-sm text-on-ink/65" data-sel-summary>{initSel.summary}</p>
          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
            <button type="button" data-open class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
              Открыть проект
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" data-calc class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors duration-300 hover:border-accent hover:text-accent">Получить расчёт</button>
          </div>
        </div>
      </div>

      <!-- Список проектов -->
      <div class="flex flex-col gap-2.5 lg:max-h-[640px] lg:overflow-y-auto lg:pr-1 no-scrollbar" data-list role="listbox" aria-label="Проекты">
        {
          initList.map((p, i) => (
            <button type="button" data-select={p.code} role="option" aria-selected={i === 0 ? "true" : "false"} class="group flex items-center gap-4 rounded-2xl border p-3 text-left transition-all duration-300 aria-selected:border-accent/60 aria-selected:bg-accent/10 border-white/10 bg-white/[0.02] hover:border-white/25">
              <span class="relative block h-[68px] w-24 shrink-0 overflow-hidden rounded-xl"><img src={p.image} alt={p.alt} loading="lazy" class="h-full w-full object-cover" /></span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-2"><span class="text-[11px] tracking-wide text-on-ink/45">{p.code}</span><span class="tnum text-xs text-on-ink/55">{p.area} м²</span></span>
                <span class="mt-1 block truncate font-[var(--font-display)] text-base text-on-ink">{p.name}</span>
                <span class="mt-0.5 block truncate text-xs text-on-ink/45">{p.summary}</span>
              </span>
              <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full border border-white/15 text-accent opacity-0 transition-opacity group-aria-selected:opacity-100" aria-hidden="true"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <script type="application/json" data-catalog set:html={JSON.stringify(payload)} />
</section>

<!-- ПОП-АП ПРОЕКТА -->
<div data-modal hidden class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-6">
  <div data-modal-overlay class="absolute inset-0 bg-ink/85 opacity-0 backdrop-blur-md transition-opacity duration-300"></div>
  <div role="dialog" aria-modal="true" aria-labelledby="modal-title" class="glass hairline-top relative flex max-h-[94dvh] w-full max-w-5xl translate-y-4 flex-col overflow-hidden rounded-[28px] opacity-0 transition-all duration-300" data-modal-dialog>

    <!-- Sticky bar -->
    <div class="sticky top-0 z-20 flex items-center justify-between gap-4 border-b border-white/10 bg-ink/65 px-5 py-3 backdrop-blur-xl sm:px-7">
      <div class="flex min-w-0 items-center gap-3">
        <span data-modal-code class="shrink-0 rounded-full border border-white/15 px-3 py-1 text-xs tracking-wide text-on-ink/80"></span>
        <span data-modal-name-sm class="truncate font-[var(--font-display)] text-on-ink"></span>
      </div>
      <button type="button" data-modal-close aria-label="Закрыть" class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-white/15 bg-ink/40 text-on-ink transition-colors hover:border-accent hover:text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Scroll body -->
    <div data-modal-scroll class="min-h-0 flex-1 overflow-y-auto">
      <!-- Hero -->
      <div class="relative aspect-[16/9] w-full">
        <img data-modal-hero src="" alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-9">
          <span data-modal-material class="eyebrow text-accent-soft"></span>
          <h3 id="modal-title" data-modal-name class="display-lg mt-3 text-on-ink"></h3>
          <p data-modal-meta class="mt-3 text-on-ink/70"></p>
        </div>
      </div>

      <div class="space-y-12 p-6 sm:space-y-14 sm:p-9">
        <!-- Цена + summary + CTA -->
        <div class="flex flex-wrap items-end justify-between gap-6 border-b border-white/10 pb-9">
          <div>
            <p class="text-xs text-on-ink/45">Стоимость под ключ</p>
            <p data-modal-price class="tnum mt-1 font-[var(--font-display)] text-3xl text-accent-soft"></p>
            <p data-modal-summary class="mt-2 text-sm text-on-ink/60"></p>
          </div>
          <div class="flex flex-wrap gap-3">
            <button type="button" data-modal-cta="smeta" class="inline-flex items-center justify-center gap-2 rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Скачать смету
            </button>
            <button type="button" data-modal-cta="presentation" class="inline-flex items-center justify-center rounded-full border border-white/25 px-6 py-3.5 text-sm font-semibold text-on-ink transition-colors duration-300 hover:border-accent hover:text-accent">Презентация</button>
          </div>
        </div>

        <!-- О проекте -->
        <section>
          <h4 class="eyebrow text-on-ink/40">О проекте</h4>
          <div data-modal-desc class="mt-5 max-w-2xl space-y-4 text-base leading-relaxed text-on-ink/75 sm:text-lg"></div>
        </section>

        <!-- Характеристики -->
        <section>
          <h4 class="eyebrow text-on-ink/40">Характеристики</h4>
          <dl data-modal-specs class="mt-5 grid gap-x-10 sm:grid-cols-2"></dl>
        </section>

        <!-- Визуализации -->
        <section data-modal-vis-wrap>
          <h4 class="eyebrow text-on-ink/40">Визуализации</h4>
          <div data-modal-vis class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2"></div>
        </section>

        <!-- Интерьеры -->
        <section data-modal-int-wrap>
          <h4 class="eyebrow text-on-ink/40">Интерьеры</h4>
          <div data-modal-int class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2"></div>
        </section>

        <!-- Планировки -->
        <section data-modal-plans-wrap>
          <h4 class="eyebrow text-on-ink/40">Планировки</h4>
          <div data-modal-plan-tabs class="mt-5 flex gap-2"></div>
          <div class="mt-3 overflow-hidden rounded-2xl border border-white/10 bg-paper">
            <img data-modal-plan-img src="" alt="" class="mx-auto w-full max-w-3xl object-contain" />
          </div>
        </section>
        <section data-modal-plans-empty hidden>
          <h4 class="eyebrow text-on-ink/40">Планировки</h4>
          <p class="mt-5 rounded-2xl border border-white/10 bg-white/[0.02] p-5 text-sm text-on-ink/55">Планировки по этому проекту пришлём по запросу — вместе со сметой.</p>
        </section>

        <!-- Видеообзор (заглушка) -->
        <section>
          <h4 class="eyebrow text-on-ink/40">Видеообзор</h4>
          <div class="relative mt-5 grid aspect-video place-items-center overflow-hidden rounded-2xl border border-white/10">
            <img data-modal-video-bg src="" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30 blur-[2px]" />
            <div class="absolute inset-0 bg-ink/55"></div>
            <div class="relative z-10 text-center">
              <span class="mx-auto grid h-16 w-16 place-items-center rounded-full border border-white/25 bg-white/10 backdrop-blur-md transition-transform duration-300 hover:scale-105">
                <svg class="ml-1 h-6 w-6 text-on-ink" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </span>
              <p class="mt-4 text-sm text-on-ink/70">Видеообзор готовим</p>
              <button type="button" data-modal-cta="video" class="mt-3 text-sm font-semibold text-accent-soft underline-offset-4 hover:underline">Запросить видеообзор →</button>
            </div>
          </div>
        </section>

        <!-- Что входит -->
        <section>
          <h4 class="eyebrow text-on-ink/40">Что входит</h4>
          <ul data-modal-features class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2"></ul>
        </section>

        <!-- Финальный CTA -->
        <div class="accent-glow rounded-3xl border border-accent/30 bg-accent/[0.06] p-7 text-center sm:p-9">
          <p class="font-[var(--font-display)] text-2xl text-on-ink">Понравился проект?</p>
          <p data-modal-final class="mx-auto mt-2 max-w-md text-sm text-on-ink/65"></p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <button type="button" data-modal-cta="smeta" class="rounded-full bg-accent px-7 py-3.5 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">Скачать смету</button>
            <button type="button" data-modal-cta="presentation" class="rounded-full border border-white/25 px-7 py-3.5 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">Получить презентацию</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ПОП-АП ЗАЯВКИ (смета / презентация / видео / расчёт) -->
<div data-req hidden class="fixed inset-0 z-[110] flex items-center justify-center p-3 sm:p-6">
  <div data-req-overlay class="absolute inset-0 bg-ink/85 opacity-0 backdrop-blur-md transition-opacity duration-300"></div>
  <div role="dialog" aria-modal="true" aria-labelledby="req-title" class="glass hairline-top relative grid max-h-[94dvh] w-full max-w-3xl translate-y-4 grid-cols-1 overflow-hidden rounded-[28px] opacity-0 transition-all duration-300 lg:grid-cols-2" data-req-dialog>

    <!-- Левая визуальная панель -->
    <div class="relative hidden overflow-hidden bg-ink-2 lg:block">
      <img data-req-img src="" alt="" class="absolute inset-0 h-full w-full object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/30"></div>
      <div class="relative z-10 flex h-full flex-col justify-between p-8">
        <span class="eyebrow text-accent-soft">Вологодское Зодчество</span>
        <div>
          <p class="font-[var(--font-display)] text-2xl text-on-ink">Что вы получите</p>
          <ul class="mt-5 space-y-3">
            {
              [
                "Смету под ключ по проекту (PDF)",
                "Планировки этажей",
                "Презентацию проекта",
                "Консультацию архитектора",
              ].map((t) => (
                <li class="flex items-baseline gap-2.5 text-sm text-on-ink/85">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {t}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 text-xs text-on-ink/40">Ответим в течение 15 минут в удобном вам канале.</p>
        </div>
      </div>
    </div>

    <!-- Форма -->
    <div class="flex min-h-0 flex-col overflow-y-auto p-7 sm:p-9">
      <button type="button" data-req-close aria-label="Закрыть" class="absolute right-4 top-4 z-20 grid h-10 w-10 place-items-center rounded-full border border-white/15 bg-ink/40 text-on-ink transition-colors hover:border-accent hover:text-accent">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
      </button>

      <!-- Состояние: форма -->
      <div data-req-formwrap>
        <p data-req-kind class="eyebrow text-accent-soft"></p>
        <h3 id="req-title" data-req-title class="mt-3 font-[var(--font-display)] text-2xl text-on-ink sm:text-3xl"></h3>
        <p data-req-sub class="mt-2 text-sm text-on-ink/55"></p>

        <form class="mt-7 space-y-5" data-req-form novalidate>
          <div>
            <label for="rq-name" class="block text-sm font-medium text-on-ink">Имя <span class="text-accent">*</span></label>
            <input id="rq-name" name="name" type="text" autocomplete="name" required class="mt-2 w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-on-ink placeholder:text-on-ink/35 focus:border-accent focus:outline-none" placeholder="Как к вам обращаться" />
            <p class="mt-1.5 hidden text-sm text-red-300" data-rq-error="name" role="alert"></p>
          </div>

          <!-- Способ связи -->
          <fieldset>
            <legend class="block text-sm font-medium text-on-ink">Куда написать <span class="text-accent">*</span></legend>
            <div class="mt-2 grid grid-cols-3 gap-2" role="radiogroup" aria-label="Способ связи" data-req-methods>
              {
                [
                  { id: "telegram", label: "Telegram", icon: '<path d="M22 4 11 13M22 4l-7 17-4-8-8-4 19-5z" stroke-linecap="round" stroke-linejoin="round"/>' },
                  { id: "max", label: "МАКС", icon: '<path d="M4 5h16v11H8l-4 4z" stroke-linecap="round" stroke-linejoin="round"/>' },
                  { id: "phone", label: "Телефон", icon: '<path d="M5 4h4l2 5-3 2a12 12 0 005 5l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke-linecap="round" stroke-linejoin="round"/>' },
                ].map((m, i) => (
                  <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-method={m.id} class="group flex flex-col items-center gap-1.5 rounded-xl border px-3 py-3 text-xs font-medium transition-colors aria-checked:border-accent aria-checked:bg-accent/10 aria-checked:text-accent-soft border-white/15 bg-white/[0.03] text-on-ink/65 hover:border-white/30">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={m.icon} />
                    {m.label}
                  </button>
                ))
              }
            </div>
          </fieldset>

          <!-- Контакт (зависит от способа) -->
          <div>
            <label for="rq-contact" class="block text-sm font-medium text-on-ink" data-req-contact-label>Telegram <span class="text-accent">*</span></label>
            <input id="rq-contact" name="contact" type="text" required class="mt-2 w-full rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-on-ink placeholder:text-on-ink/35 focus:border-accent focus:outline-none" placeholder="@username или телефон" data-req-contact />
            <p class="mt-1.5 hidden text-sm text-red-300" data-rq-error="contact" role="alert"></p>
          </div>

          <label class="flex items-start gap-3 text-sm text-on-ink/60">
            <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-[#B0885A]" />
            <span>Согласен на обработку персональных данных и <a href="#" class="text-accent-soft underline underline-offset-2">политику конфиденциальности</a>.</span>
          </label>
          <p class="hidden text-sm text-red-300" data-rq-error="consent" role="alert"></p>

          <button type="submit" data-req-submit class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-4 text-base font-semibold text-paper transition-transform duration-300 hover:scale-[1.02] disabled:opacity-60">
            <span data-req-submit-label>Отправить</span>
            <svg class="hidden h-5 w-5 animate-spin" data-req-spinner viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" stroke-opacity="0.3"/><path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
          </button>
          <p class="text-center text-xs text-on-ink/40">Это бесплатно и ни к чему не обязывает.</p>
        </form>
      </div>

      <!-- Состояние: успех -->
      <div data-req-success hidden class="flex flex-col items-center justify-center py-10 text-center">
        <span class="grid h-16 w-16 place-items-center rounded-full border border-accent/40 text-accent accent-glow">
          <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3 class="mt-5 font-[var(--font-display)] text-2xl text-on-ink">Заявка принята</h3>
        <p data-req-success-text class="mt-3 max-w-xs text-sm text-on-ink/60"></p>
        <button type="button" data-req-close class="mt-7 rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-on-ink transition-colors hover:border-accent hover:text-accent">Закрыть</button>
      </div>
    </div>
  </div>
</div>

<script>
  type Spec = { label: string; value: string };
  type Plan = { floor: string; src: string };
  type Img = { src: string; alt: string };
  type P = { code: string; name: string; material: string; materialLabel: string; area: number; floors: number; price: string; image: string; alt: string; description: string; summary: string; specs: Spec[]; longDescription?: string[]; features?: string[]; gallery?: Img[]; plans?: Plan[] };
  type Payload = { groups: { id: string; label: string; note: string; codes: string[] }[]; projects: Record<string, P>; interiors: Img[]; defaultFeatures: string[] };

  const root = document.querySelector<HTMLElement>("#catalog");
  if (root) {
    const data: Payload = JSON.parse(root.querySelector<HTMLElement>("[data-catalog]")!.textContent || "{}");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const indicator = root.querySelector<HTMLElement>("[data-indicator]")!;
    const note = root.querySelector<HTMLElement>("[data-note]")!;
    const backdrop = root.querySelector<HTMLImageElement>("[data-backdrop]")!;
    const list = root.querySelector<HTMLElement>("[data-list]")!;
    const selImg = root.querySelector<HTMLImageElement>("[data-sel-img]")!;
    let selected = data.groups[0].codes[0];

    const setText = (sel: string, scope: ParentNode, val: string) => { const el = scope.querySelector<HTMLElement>(sel); if (el) el.textContent = val; };
    const swapImg = (img: HTMLImageElement, src: string) => {
      if (reduce) { img.src = src; return; }
      img.style.opacity = "0";
      const n = new Image(); n.onload = () => { img.src = src; img.style.opacity = ""; }; n.src = src;
    };
    const moveIndicator = (tab: HTMLButtonElement) => { indicator.style.width = `${tab.offsetWidth}px`; indicator.style.transform = `translateX(${tab.offsetLeft - 6}px)`; };

    const selectProject = (code: string) => {
      const p = data.projects[code]; if (!p) return;
      selected = code;
      swapImg(selImg, p.image); selImg.alt = p.alt; swapImg(backdrop, p.image);
      setText("[data-sel-code]", root, p.code);
      setText("[data-sel-name]", root, p.name);
      setText("[data-sel-meta]", root, `${p.area} м² · ${p.floors} этажа`);
      setText("[data-sel-summary]", root, p.summary);
      setText("[data-sel-price]", root, p.price);
      list.querySelectorAll<HTMLElement>("[data-select]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.select === code)));
    };

    const buildList = (groupId: string) => {
      const g = data.groups.find((x) => x.id === groupId)!;
      list.innerHTML = g.codes.map((c, i) => {
        const p = data.projects[c];
        return `<button type="button" data-select="${p.code}" role="option" aria-selected="${i === 0}" class="group flex items-center gap-4 rounded-2xl border p-3 text-left transition-all duration-300 aria-selected:border-accent/60 aria-selected:bg-accent/10 border-white/10 bg-white/[0.02] hover:border-white/25">
          <span class="relative block h-[68px] w-24 shrink-0 overflow-hidden rounded-xl"><img src="${p.image}" alt="${p.alt}" loading="lazy" class="h-full w-full object-cover"></span>
          <span class="min-w-0 flex-1">
            <span class="flex items-center justify-between gap-2"><span class="text-[11px] tracking-wide text-on-ink/45">${p.code}</span><span class="tnum text-xs text-on-ink/55">${p.area} м²</span></span>
            <span class="mt-1 block truncate font-[var(--font-display)] text-base text-on-ink">${p.name}</span>
            <span class="mt-0.5 block truncate text-xs text-on-ink/45">${p.summary}</span>
          </span>
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full border border-white/15 text-accent opacity-0 transition-opacity group-aria-selected:opacity-100" aria-hidden="true"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </button>`;
      }).join("");
    };

    const switchMaterial = (groupId: string, focus = false) => {
      tabs.forEach((t) => { const s = t.dataset.tab === groupId; t.setAttribute("aria-selected", String(s)); t.tabIndex = s ? 0 : -1; if (s) { moveIndicator(t); if (focus) t.focus(); } });
      const g = data.groups.find((x) => x.id === groupId)!;
      note.style.opacity = "0";
      setTimeout(() => { note.textContent = `${g.note}. Переключайте проекты справа, открывайте карточку — внутри визуализации, интерьеры и планировки.`; note.style.opacity = "1"; }, reduce ? 0 : 160);
      buildList(groupId); selectProject(g.codes[0]);
    };
    note.style.transition = "opacity .3s ease";

    tabs.forEach((tab) => tab.addEventListener("click", () => switchMaterial(tab.dataset.tab!)));
    root.querySelector("[data-tablist]")!.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent; const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true"); let next = cur;
      if (ev.key === "ArrowRight") next = (cur + 1) % tabs.length; else if (ev.key === "ArrowLeft") next = (cur - 1 + tabs.length) % tabs.length;
      else if (ev.key === "Home") next = 0; else if (ev.key === "End") next = tabs.length - 1; else return;
      ev.preventDefault(); switchMaterial(tabs[next].dataset.tab!, true);
    });
    list.addEventListener("click", (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>("[data-select]"); if (b) selectProject(b.dataset.select!); });

    // ====================== ПОП-АП ======================
    const modal = document.querySelector<HTMLElement>("[data-modal]")!;
    const dialog = modal.querySelector<HTMLElement>("[data-modal-dialog]")!;
    const overlay = modal.querySelector<HTMLElement>("[data-modal-overlay]")!;
    const scroll = modal.querySelector<HTMLElement>("[data-modal-scroll]")!;
    const hero = modal.querySelector<HTMLImageElement>("[data-modal-hero]")!;
    const videoBg = modal.querySelector<HTMLImageElement>("[data-modal-video-bg]")!;
    const mSpecs = modal.querySelector<HTMLElement>("[data-modal-specs]")!;
    const mFeatures = modal.querySelector<HTMLElement>("[data-modal-features]")!;
    const mDesc = modal.querySelector<HTMLElement>("[data-modal-desc]")!;
    const mVis = modal.querySelector<HTMLElement>("[data-modal-vis]")!;
    const mVisWrap = modal.querySelector<HTMLElement>("[data-modal-vis-wrap]")!;
    const mInt = modal.querySelector<HTMLElement>("[data-modal-int]")!;
    const mIntWrap = modal.querySelector<HTMLElement>("[data-modal-int-wrap]")!;
    const plansWrap = modal.querySelector<HTMLElement>("[data-modal-plans-wrap]")!;
    const plansEmpty = modal.querySelector<HTMLElement>("[data-modal-plans-empty]")!;
    const planTabs = modal.querySelector<HTMLElement>("[data-modal-plan-tabs]")!;
    const planImg = modal.querySelector<HTMLImageElement>("[data-modal-plan-img]")!;
    let lastFocused: HTMLElement | null = null;

    const imgCard = (g: Img, cls: string) => `<figure class="overflow-hidden rounded-2xl border border-white/10 ${cls}"><img src="${g.src}" alt="${g.alt}" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"></figure>`;

    const openModal = (code: string) => {
      const p = data.projects[code]; if (!p) return;
      lastFocused = document.activeElement as HTMLElement;
      const exts = p.gallery && p.gallery.length ? p.gallery : [{ src: p.image, alt: p.alt }];

      swapImg(hero, exts[0].src); hero.alt = exts[0].alt;
      videoBg.src = exts[0].src;
      setText("[data-modal-code]", modal, p.code);
      setText("[data-modal-name-sm]", modal, p.name);
      setText("[data-modal-material]", modal, p.materialLabel);
      setText("[data-modal-name]", modal, p.name);
      setText("[data-modal-meta]", modal, `${p.area} м² · ${p.floors} этажа · ${p.materialLabel}`);
      setText("[data-modal-price]", modal, p.price);
      setText("[data-modal-summary]", modal, p.summary);
      setText("[data-modal-final]", modal, `Пришлём смету, планировки и презентацию по проекту ${p.code} «${p.name}».`);

      const paras = p.longDescription && p.longDescription.length ? p.longDescription : [p.description];
      mDesc.innerHTML = paras.map((t) => `<p>${t}</p>`).join("");

      mSpecs.innerHTML = p.specs.map((s) => `<div class="flex items-baseline justify-between gap-4 border-b border-white/10 py-3.5"><dt class="text-sm text-on-ink/50">${s.label}</dt><dd class="text-right font-[var(--font-display)] text-on-ink">${s.value}</dd></div>`).join("");

      const feats = p.features && p.features.length ? p.features : data.defaultFeatures;
      mFeatures.innerHTML = feats.map((f) => `<li class="flex items-baseline gap-2.5 text-sm text-on-ink/80"><svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>${f}</li>`).join("");

      // Визуализации — все внешние кадры (первый крупный, если их несколько)
      if (exts.length) {
        mVisWrap.hidden = false;
        mVis.innerHTML = exts.map((g, i) => imgCard(g, i === 0 && exts.length > 1 ? "sm:col-span-2 aspect-[16/9]" : "aspect-[4/3]")).join("");
      } else mVisWrap.hidden = true;

      // Интерьеры
      mIntWrap.hidden = false;
      mInt.innerHTML = data.interiors.map((g) => imgCard(g, "aspect-[4/3]")).join("");

      // Планировки
      if (p.plans && p.plans.length) {
        plansWrap.hidden = false; plansEmpty.hidden = true;
        const render = (idx: number) => {
          planImg.src = p.plans![idx].src; planImg.alt = `Планировка — ${p.plans![idx].floor}`;
          planTabs.querySelectorAll<HTMLElement>("[data-plan]").forEach((b, i2) => { const on = i2 === idx; b.className = `rounded-full border px-4 py-2 text-sm transition-colors ${on ? "border-accent bg-accent/15 text-accent-soft" : "border-white/15 text-on-ink/60 hover:text-on-ink"}`; });
        };
        planTabs.innerHTML = p.plans.map((pl, idx) => `<button type="button" data-plan="${idx}" class="rounded-full border px-4 py-2 text-sm transition-colors ${idx === 0 ? "border-accent bg-accent/15 text-accent-soft" : "border-white/15 text-on-ink/60"}">${pl.floor}</button>`).join("");
        planTabs.querySelectorAll<HTMLButtonElement>("[data-plan]").forEach((b) => b.addEventListener("click", () => render(Number(b.dataset.plan))));
        render(0);
      } else { plansWrap.hidden = true; plansEmpty.hidden = false; }

      scroll.scrollTop = 0;
      modal.hidden = false; document.body.style.overflow = "hidden";
      requestAnimationFrame(() => { overlay.style.opacity = "1"; dialog.style.opacity = "1"; dialog.style.transform = "translateY(0)"; });
      modal.querySelector<HTMLButtonElement>("[data-modal-close]")!.focus();
    };
    const closeModal = () => {
      overlay.style.opacity = "0"; dialog.style.opacity = "0"; dialog.style.transform = "translateY(16px)";
      const done = () => { modal.hidden = true; document.body.style.overflow = ""; lastFocused?.focus(); };
      if (reduce) done(); else setTimeout(done, 280);
    };

    root.querySelectorAll<HTMLElement>("[data-open]").forEach((b) => b.addEventListener("click", () => openModal(selected)));
    modal.querySelector("[data-modal-close]")!.addEventListener("click", closeModal);
    overlay.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (modal.hidden) return;
      if (e.key === "Escape") closeModal();
      else if (e.key === "Tab") {
        const f = dialog.querySelectorAll<HTMLElement>('button, a[href], [tabindex]:not([tabindex="-1"])');
        if (!f.length) return; const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // ====================== ПОП-АП ЗАЯВКИ ======================
    const req = document.querySelector<HTMLElement>("[data-req]")!;
    const reqDialog = req.querySelector<HTMLElement>("[data-req-dialog]")!;
    const reqOverlay = req.querySelector<HTMLElement>("[data-req-overlay]")!;
    const reqImg = req.querySelector<HTMLImageElement>("[data-req-img]")!;
    const reqForm = req.querySelector<HTMLFormElement>("[data-req-form]")!;
    const reqFormWrap = req.querySelector<HTMLElement>("[data-req-formwrap]")!;
    const reqSuccess = req.querySelector<HTMLElement>("[data-req-success]")!;
    const reqContact = req.querySelector<HTMLInputElement>("[data-req-contact]")!;
    const reqContactLabel = req.querySelector<HTMLElement>("[data-req-contact-label]")!;
    const reqMethodBtns = Array.from(req.querySelectorAll<HTMLButtonElement>("[data-method]"));
    const reqSubmit = req.querySelector<HTMLButtonElement>("[data-req-submit]")!;
    const reqSubmitLabel = req.querySelector<HTMLElement>("[data-req-submit-label]")!;
    const reqSpinner = req.querySelector<HTMLElement>("[data-req-spinner]")!;
    const endpoint = document.querySelector<HTMLFormElement>("[data-lead-form]")?.dataset.endpoint || "";

    const methods: Record<string, { label: string; ph: string; type: string }> = {
      telegram: { label: "Telegram", ph: "@username или телефон", type: "text" },
      max: { label: "МАКС", ph: "Номер или ID в МАКС", type: "text" },
      phone: { label: "Телефон", ph: "+7 (___) ___-__-__", type: "tel" },
    };
    const kindMap: Record<string, [string, string]> = {
      smeta: ["Смета", "Скачать смету"],
      presentation: ["Презентация", "Получить презентацию"],
      video: ["Видеообзор", "Запросить видеообзор"],
      calc: ["Расчёт", "Получить расчёт"],
    };
    let reqMethod = "telegram", reqIntent = "smeta", reqProject = selected, reqLastFocus: HTMLElement | null = null;

    const reqError = (field: string, msg: string) => {
      const el = req.querySelector<HTMLElement>(`[data-rq-error="${field}"]`);
      if (el) { el.textContent = msg; el.classList.toggle("hidden", !msg); }
    };
    const setMethod = (m: string) => {
      reqMethod = m;
      reqMethodBtns.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.method === m)));
      reqContactLabel.innerHTML = `${methods[m].label} <span class="text-accent">*</span>`;
      reqContact.type = methods[m].type;
      reqContact.placeholder = methods[m].ph;
      reqError("contact", "");
    };
    reqMethodBtns.forEach((b) => b.addEventListener("click", () => setMethod(b.dataset.method!)));

    const openRequest = (intent: string) => {
      reqIntent = intent; reqProject = selected;
      const p = data.projects[reqProject];
      reqLastFocus = document.activeElement as HTMLElement;
      reqImg.src = p.image; reqImg.alt = p.alt;
      setText("[data-req-kind]", req, kindMap[intent][0]);
      setText("[data-req-title]", req, kindMap[intent][1]);
      setText("[data-req-sub]", req, `по проекту ${p.code} «${p.name}»`);
      reqSubmitLabel.textContent = kindMap[intent][1];
      reqForm.reset(); ["name", "contact", "consent"].forEach((f) => reqError(f, ""));
      setMethod("telegram");
      reqFormWrap.hidden = false; reqSuccess.hidden = true;
      req.hidden = false; document.body.style.overflow = "hidden";
      requestAnimationFrame(() => { reqOverlay.style.opacity = "1"; reqDialog.style.opacity = "1"; reqDialog.style.transform = "translateY(0)"; });
      setTimeout(() => req.querySelector<HTMLInputElement>("#rq-name")?.focus(), reduce ? 0 : 200);
    };
    const closeRequest = () => {
      reqOverlay.style.opacity = "0"; reqDialog.style.opacity = "0"; reqDialog.style.transform = "translateY(16px)";
      const done = () => { req.hidden = true; document.body.style.overflow = ""; reqLastFocus?.focus(); };
      if (reduce) done(); else setTimeout(done, 280);
    };
    req.querySelectorAll<HTMLButtonElement>("[data-req-close]").forEach((b) => b.addEventListener("click", closeRequest));
    reqOverlay.addEventListener("click", closeRequest);

    reqForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(reqForm);
      const name = String(fd.get("name") || "").trim();
      const contact = String(fd.get("contact") || "").trim();
      const consent = reqForm.querySelector<HTMLInputElement>('[name="consent"]')!.checked;
      let firstInvalid: HTMLElement | null = null;
      ["name", "contact", "consent"].forEach((f) => reqError(f, ""));
      if (!name) { reqError("name", "Укажите, как к вам обращаться"); firstInvalid ??= req.querySelector("#rq-name"); }
      const okContact = reqMethod === "phone" ? contact.replace(/\D/g, "").length >= 10 : contact.length >= 2;
      if (!okContact) { reqError("contact", `Укажите ваш ${methods[reqMethod].label}`); firstInvalid ??= reqContact; }
      if (!consent) { reqError("consent", "Нужно согласие на обработку данных"); }
      if (firstInvalid || !consent) { firstInvalid?.focus(); return; }

      const p = data.projects[reqProject];
      const payloadReq = { name, method: methods[reqMethod].label, contact, request: `${kindMap[reqIntent][0]} по проекту ${p.code} «${p.name}»`, project: p.code };
      reqSubmit.disabled = true; reqSpinner.classList.remove("hidden"); reqSubmitLabel.textContent = "Отправляем…";
      try {
        if (endpoint) {
          const res = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payloadReq) });
          if (!res.ok) throw new Error("bad");
        } else { console.info("Request (demo):", payloadReq); await new Promise((r) => setTimeout(r, 600)); }
        setText("[data-req-success-text]", req, `Свяжемся с вами в ${methods[reqMethod].label} и пришлём ${kindMap[reqIntent][0].toLowerCase()} по проекту «${p.name}».`);
        reqFormWrap.hidden = true; reqSuccess.hidden = false;
      } catch {
        reqError("contact", "Не удалось отправить. Позвоните: 8 (499) 113-57-63");
      } finally {
        reqSubmit.disabled = false; reqSpinner.classList.add("hidden"); reqSubmitLabel.textContent = kindMap[reqIntent][1];
      }
    });

    document.addEventListener("keydown", (e) => {
      if (req.hidden) return;
      if (e.key === "Escape") closeRequest();
      else if (e.key === "Tab") {
        const f = reqDialog.querySelectorAll<HTMLElement>('button, a[href], input, [tabindex]:not([tabindex="-1"])');
        const vis = Array.from(f).filter((el) => el.offsetParent !== null);
        if (!vis.length) return; const first = vis[0], last = vis[vis.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // CTA → открыть модалку заявки (закрыв карточку проекта, если открыта)
    modal.querySelectorAll<HTMLButtonElement>("[data-modal-cta]").forEach((btn) => btn.addEventListener("click", () => { const k = btn.dataset.modalCta!; closeModal(); setTimeout(() => openRequest(k), reduce ? 0 : 320); }));
    root.querySelectorAll<HTMLElement>("[data-calc]").forEach((b) => b.addEventListener("click", () => openRequest("calc")));

    const init = () => { const a = tabs.find((t) => t.getAttribute("aria-selected") === "true"); if (a) moveIndicator(a); };
    window.addEventListener("load", init); window.addEventListener("resize", init); init();
  }
</script>
