    const mSpecs = modal.querySelector<HTMLElement>("[data-modal-specs]")!;
    const mFeats = modal.querySelector<HTMLElement>("[data-modal-feats]")!;
    const stagesTabs = modal.querySelector<HTMLElement>("[data-stages-tabs]")!;
    const stagesPanel = modal.querySelector<HTMLElement>("[data-stages-panel]")!;
    const mDesc = modal.querySelector<HTMLElement>("[data-modal-desc]")!;
    const mVis = modal.querySelector<HTMLElement>("[data-modal-vis]")!;
    const mVisWrap = modal.querySelector<HTMLElement>("[data-modal-vis-wrap]")!;
    const mInt = modal.querySelector<HTMLElement>("[data-modal-int]")!;
    const mIntWrap = modal.querySelector<HTMLElement>("[data-modal-int-wrap]")!;
    const plansWrap = modal.querySelector<HTMLElement>("[data-modal-plans-wrap]")!;
    const plansEmpty = modal.querySelector<HTMLElement>("[data-modal-plans-empty]")!;
    const planTabs = modal.querySelector<HTMLElement>("[data-modal-plan-tabs]")!;
    const planImg = modal.querySelector<HTMLImageElement>("[data-modal-plan-img]")!;
    let lastFocused: HTMLElement | null = null;

    const imgCard = (g: Img, cls: string) => `<figure class="overflow-hidden rounded-2xl border border-white/10 ${cls}"><img src="${g.src}" alt="${g.alt}" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.04]"></figure>`;

    // Этапы «что входит» (табы)
    let stageMaterial = "timber";
    const setStage = (i: number) => {
      const s = data.stages[i];
      const photo = stageMaterial === "ceramic" ? (s.photoCeramic ?? s.photo) : (s.photoTimber ?? s.photo);
      stagesTabs.querySelectorAll<HTMLElement>("[data-stagetab]").forEach((b, n) => {
        const on = n === i;
        b.setAttribute("aria-selected", String(on));
      });
      stagesPanel.innerHTML = `<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
        <div class="relative grid aspect-[4/3] place-items-center overflow-hidden rounded-2xl border border-white/10 bg-ink-2">
          ${photo ? `<img src="${photo}" alt="${s.label}" loading="lazy" class="absolute inset-0 h-full w-full object-cover"><span class="absolute inset-0 bg-gradient-to-t from-ink/55 to-transparent"></span>` : `<div class="px-6 text-center text-on-ink/40"><svg class="mx-auto h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">${s.icon}</svg><p class="mt-3 text-xs">Фото этапа · ${s.label} (заглушка)</p></div>`}
          ${s.badge ? `<div class="absolute inset-x-4 bottom-4 flex items-center gap-2 rounded-xl border border-accent/30 bg-accent/15 px-4 py-3 text-sm text-accent-soft backdrop-blur-md"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>${s.badge}</div>` : ""}
        </div>
        <div>
          <p class="font-[var(--font-display)] text-xl text-on-ink">${s.heading}</p>
          <ul class="mt-5 space-y-3.5">${s.items.map((it) => `<li class="flex gap-3 text-sm leading-relaxed"><svg class="mt-1 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span><span class="font-semibold text-on-ink">${it.t}</span> <span class="text-on-ink/60">— ${it.d}</span></span></li>`).join("")}</ul>
          <button type="button" data-stage-cta class="mt-7 inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-paper transition-transform duration-300 hover:scale-[1.02]">Получить полную комплектацию</button>
        </div>
      </div>`;
    };
    const renderStages = () => {
      stagesTabs.innerHTML = data.stages.map((s, i) => `<button type="button" role="tab" data-stagetab="${i}" aria-selected="${i === 0}" class="group flex shrink-0 flex-col items-center gap-2 rounded-2xl border px-4 py-3 transition-colors aria-selected:border-accent/60 aria-selected:bg-accent/10 border-white/10 bg-white/[0.02] hover:border-white/25">
        <svg class="h-6 w-6 text-on-ink/45 transition-colors group-aria-selected:text-accent-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">${s.icon}</svg>
        <span class="whitespace-nowrap text-[11px] font-medium uppercase tracking-wide text-on-ink/55 transition-colors group-aria-selected:text-on-ink">${s.label}</span>
      </button>`).join("");
      stagesTabs.querySelectorAll<HTMLButtonElement>("[data-stagetab]").forEach((b) => b.addEventListener("click", () => setStage(Number(b.dataset.stagetab))));
      setStage(0);
    };

    const openModal = (code: string) => {
      const p = data.projects[code]; if (!p) return;
      lastFocused = document.activeElement as HTMLElement;
      const exts = p.gallery && p.gallery.length ? p.gallery : [{ src: p.image, alt: p.alt }];

      swapImg(hero, exts[0].src); hero.alt = exts[0].alt;
      videoBg.src = exts[0].src;
      setText("[data-modal-code]", modal, p.code);
      setText("[data-modal-name-sm]", modal, p.name);
      setText("[data-modal-material]", modal, p.materialLabel);
      setText("[data-modal-name]", modal, p.name);
      setText("[data-modal-meta]", modal, `${p.area} м² · ${p.floors} этажа · ${p.materialLabel}`);
      setText("[data-modal-price]", modal, p.price);
      setText("[data-modal-summary]", modal, p.summary);
      setText("[data-modal-final]", modal, `Пришлём смету, планировки и презентацию по проекту ${p.code} «${p.name}».`);

      const paras = p.longDescription && p.longDescription.length ? p.longDescription : [p.description];
      mDesc.innerHTML = paras.map((t) => `<p>${t}</p>`).join("");

      mSpecs.innerHTML = p.specs.map((s) => `<div class="flex items-baseline justify-between gap-4 border-b border-white/10 py-3.5"><dt class="text-sm text-on-ink/50">${s.label}</dt><dd class="text-right font-[var(--font-display)] text-on-ink">${s.value}</dd></div>`).join("");

      const feats = p.features && p.features.length ? p.features : data.defaultFeatures;
      mFeats.innerHTML = feats.map((f) => `<li class="rounded-full border border-white/12 bg-white/[0.03] px-3.5 py-1.5 text-xs text-on-ink/75">${f}</li>`).join("");
      stageMaterial = p.material;
      renderStages();

      // Визуализации — все внешние кадры (первый крупный, если их несколько)
      if (exts.length) {
        mVisWrap.hidden = false;
        mVis.innerHTML = exts.map((g, i) => imgCard(g, i === 0 && exts.length > 1 ? "sm:col-span-2 aspect-[16/9]" : "aspect-[4/3]")).join("");
      } else mVisWrap.hidden = true;

      // Интерьеры
      mIntWrap.hidden = false;
      mInt.innerHTML = data.interiors.map((g) => imgCard(g, "aspect-[4/3]")).join("");

      // Планировки
      if (p.plans && p.plans.length) {
        plansWrap.hidden = false; plansEmpty.hidden = true;
        const render = (idx: number) => {
          planImg.src = p.plans![idx].src; planImg.alt = `Планировка — ${p.plans![idx].floor}`;
          planTabs.querySelectorAll<HTMLElement>("[data-plan]").forEach((b, i2) => { const on = i2 === idx; b.className = `rounded-full border px-4 py-2 text-sm transition-colors ${on ? "border-accent bg-accent/15 text-accent-soft" : "border-white/15 text-on-ink/60 hover:text-on-ink"}`; });
        };
        planTabs.innerHTML = p.plans.map((pl, idx) => `<button type="button" data-plan="${idx}" class="rounded-full border px-4 py-2 text-sm transition-colors ${idx === 0 ? "border-accent bg-accent/15 text-accent-soft" : "border-white/15 text-on-ink/60"}">${pl.floor}</button>`).join("");
        planTabs.querySelectorAll<HTMLButtonElement>("[data-plan]").forEach((b) => b.addEventListener("click", () => render(Number(b.dataset.plan))));
        render(0);
      } else { plansWrap.hidden = true; plansEmpty.hidden = false; }

      // Видеообзор дома: реальное видео (фасад) или заглушка
      videoReal.querySelector("video")?.remove();
      if (p.video) {
        modalVideoSrc = p.video;
        videoPoster.src = exts[0].src; videoPoster.alt = `Видеообзор — ${p.name}`;
        videoReal.hidden = false; videoStub.hidden = true;
      } else {
        modalVideoSrc = "";
        videoBg.src = exts[0].src;
        videoReal.hidden = true; videoStub.hidden = false;
      }

      scroll.scrollTop = 0;
      modal.hidden = false; document.body.style.overflow = "hidden";
      requestAnimationFrame(() => { overlay.style.opacity = "1"; dialog.style.opacity = "1"; dialog.style.transform = "translateY(0)"; });
      modal.querySelector<HTMLButtonElement>("[data-modal-close]")!.focus();
    };
    const closeModal = () => {
      overlay.style.opacity = "0"; dialog.style.opacity = "0"; dialog.style.transform = "translateY(16px)";
      videoReal.querySelector("video")?.remove(); // остановить и выгрузить плеер
      const done = () => { modal.hidden = true; document.body.style.overflow = ""; lastFocused?.focus(); };
      if (reduce) done(); else setTimeout(done, 280);
    };

    // Видеообзор — подгружаем <video> по клику (фасад)
    videoPlay.addEventListener("click", () => {
      if (!modalVideoSrc || videoReal.querySelector("video")) return;
      const v = document.createElement("video");
      v.src = modalVideoSrc;
      v.controls = true; v.autoplay = true; v.playsInline = true; v.preload = "metadata";
      v.className = "absolute inset-0 z-20 h-full w-full bg-ink object-cover";
      videoReal.appendChild(v);
      v.play().catch(() => {});
    });

    // Делегирование: «Открыть проект» — работает и для динамических разворотов/карусели
    root.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("[data-open]")) openModal(selected); });
    modal.querySelector("[data-modal-close]")!.addEventListener("click", closeModal);
    overlay.addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => {
      if (modal.hidden) return;
      if (e.key === "Escape") closeModal();
      else if (e.key === "Tab") {
        const f = dialog.querySelectorAll<HTMLElement>('button, a[href], [tabindex]:not([tabindex="-1"])');
        if (!f.length) return; const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // ====================== ПОП-АП ЗАЯВКИ ======================
    const req = document.querySelector<HTMLElement>("[data-req]")!;
    const reqDialog = req.querySelector<HTMLElement>("[data-req-dialog]")!;
    const reqOverlay = req.querySelector<HTMLElement>("[data-req-overlay]")!;
    const reqImg = req.querySelector<HTMLImageElement>("[data-req-img]")!;
    const reqForm = req.querySelector<HTMLFormElement>("[data-req-form]")!;
    const reqFormWrap = req.querySelector<HTMLElement>("[data-req-formwrap]")!;
    const reqSuccess = req.querySelector<HTMLElement>("[data-req-success]")!;
    const reqPhone = req.querySelector<HTMLInputElement>("[data-req-phone]")!;
    const reqTgWrap = req.querySelector<HTMLElement>("[data-req-tg]")!;
    const reqMethodBtns = Array.from(req.querySelectorAll<HTMLButtonElement>("[data-method]"));
    const reqSubmit = req.querySelector<HTMLButtonElement>("[data-req-submit]")!;
    const reqSubmitLabel = req.querySelector<HTMLElement>("[data-req-submit-label]")!;
    const reqSpinner = req.querySelector<HTMLElement>("[data-req-spinner]")!;
    const endpoint = document.querySelector<HTMLFormElement>("[data-lead-form]")?.dataset.endpoint || "";

    const methods: Record<string, { label: string }> = {
      telegram: { label: "Telegram" },
      max: { label: "МАКС" },
      phone: { label: "Телефон" },
    };
    const kindMap: Record<string, [string, string]> = {
      smeta: ["Смета", "Скачать смету"],
      presentation: ["Презентация", "Получить презентацию"],
      video: ["Видеообзор", "Запросить видеообзор"],
      calc: ["Расчёт", "Получить расчёт"],
      layout: ["Планировка", "Изменить планировку"],
      complectation: ["Комплектация", "Получить комплектацию"],
    };
    let reqMethod = "telegram", reqIntent = "smeta", reqProject = selected, reqLastFocus: HTMLElement | null = null;

    const reqError = (field: string, msg: string) => {
      const el = req.querySelector<HTMLElement>(`[data-rq-error="${field}"]`);
      if (el) { el.textContent = msg; el.classList.toggle("hidden", !msg); }
    };
    const formatRuPhone = (v: string) => {
      let d = v.replace(/\D/g, "");
      if (d[0] === "8") d = "7" + d.slice(1);
      if (d[0] !== "7") d = "7" + d;
      d = d.slice(0, 11);
      let r = "+7";
      if (d.length > 1) r += " (" + d.slice(1, 4);
      if (d.length >= 4) r += ") " + d.slice(4, 7);
      if (d.length >= 7) r += "-" + d.slice(7, 9);
      if (d.length >= 9) r += "-" + d.slice(9, 11);
      return r;
    };
    const setMethod = (m: string) => {
      reqMethod = m;
      reqMethodBtns.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.method === m)));
      reqTgWrap.hidden = m !== "telegram"; // ник в Telegram — только при выборе Telegram, необязателен
    };
    reqMethodBtns.forEach((b) => b.addEventListener("click", () => setMethod(b.dataset.method!)));
    reqPhone.addEventListener("input", () => { reqPhone.value = formatRuPhone(reqPhone.value); });
    reqPhone.addEventListener("focus", () => { if (!reqPhone.value) reqPhone.value = "+7 "; });

    const openRequest = (intent: string) => {
      reqIntent = intent; reqProject = selected;
      const p = data.projects[reqProject];
      reqLastFocus = document.activeElement as HTMLElement;
      reqImg.src = p.image; reqImg.alt = p.alt;
      setText("[data-req-kind]", req, kindMap[intent][0]);
      setText("[data-req-title]", req, kindMap[intent][1]);
      setText("[data-req-sub]", req, `по проекту ${p.code} «${p.name}»`);
      reqSubmitLabel.textContent = kindMap[intent][1];
      reqForm.reset(); ["name", "phone", "consent"].forEach((f) => reqError(f, ""));
      setMethod("phone");
      reqFormWrap.hidden = false; reqSuccess.hidden = true;
      req.hidden = false; document.body.style.overflow = "hidden";
      requestAnimationFrame(() => { reqOverlay.style.opacity = "1"; reqDialog.style.opacity = "1"; reqDialog.style.transform = "translateY(0)"; });
      setTimeout(() => req.querySelector<HTMLInputElement>("#rq-name")?.focus(), reduce ? 0 : 200);
    };
    const closeRequest = () => {
      reqOverlay.style.opacity = "0"; reqDialog.style.opacity = "0"; reqDialog.style.transform = "translateY(16px)";
      const done = () => { req.hidden = true; document.body.style.overflow = ""; reqLastFocus?.focus(); };
      if (reduce) done(); else setTimeout(done, 280);
    };
    req.querySelectorAll<HTMLButtonElement>("[data-req-close]").forEach((b) => b.addEventListener("click", closeRequest));
    reqOverlay.addEventListener("click", closeRequest);

    reqForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(reqForm);
      const name = String(fd.get("name") || "").trim();
      const phone = String(fd.get("phone") || "").trim();
      const telegram = String(fd.get("telegram") || "").trim();
      const consent = reqForm.querySelector<HTMLInputElement>('[name="consent"]')!.checked;
      let firstInvalid: HTMLElement | null = null;
      ["name", "phone", "consent"].forEach((f) => reqError(f, ""));
      if (!name) { reqError("name", "Укажите, как к вам обращаться"); firstInvalid ??= req.querySelector("#rq-name"); }
      if (phone.replace(/\D/g, "").length < 10) { reqError("phone", "Введите корректный номер телефона"); firstInvalid ??= reqPhone; }
      if (!consent) { reqError("consent", "Нужно согласие на обработку данных"); }
      if (firstInvalid || !consent) { firstInvalid?.focus(); return; }

      const p = data.projects[reqProject];
      const payloadReq = { name, phone, channel: methods[reqMethod].label, telegram: reqMethod === "telegram" ? telegram : "", request: `${kindMap[reqIntent][0]} по проекту ${p.code} «${p.name}»`, project: p.code };
      reqSubmit.disabled = true; reqSpinner.classList.remove("hidden"); reqSubmitLabel.textContent = "Отправляем…";
      try {
        if (endpoint) {
          const res = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payloadReq) });
          if (!res.ok) throw new Error("bad");
        } else { console.info("Request (demo):", payloadReq); await new Promise((r) => setTimeout(r, 600)); }
        setText("[data-req-success-text]", req, `Свяжемся с вами по телефону или в ${methods[reqMethod].label} и пришлём ${kindMap[reqIntent][0].toLowerCase()} по проекту «${p.name}».`);
        reqFormWrap.hidden = true; reqSuccess.hidden = false;
      } catch {
        reqError("phone", "Не удалось отправить. Позвоните: 8 (499) 113-57-63");
      } finally {
        reqSubmit.disabled = false; reqSpinner.classList.add("hidden"); reqSubmitLabel.textContent = kindMap[reqIntent][1];
      }
    });

    document.addEventListener("keydown", (e) => {
      if (req.hidden) return;
      if (e.key === "Escape") closeRequest();
      else if (e.key === "Tab") {
        const f = reqDialog.querySelectorAll<HTMLElement>('button, a[href], input, [tabindex]:not([tabindex="-1"])');
        const vis = Array.from(f).filter((el) => el.offsetParent !== null);
        if (!vis.length) return; const first = vis[0], last = vis[vis.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    // Открыть квиз (комплектация/смета) с текущим проектом
    const openQuiz = (kind: string, code?: string) => {
      const p = data.projects[code || selected];
      document.dispatchEvent(new CustomEvent("vz-quiz", { detail: { kind, project: p ? { code: p.code, name: p.name } : null } }));
    };

    // CTA в карточке проекта: «Скачать смету» → квиз сметы; «Презентация/Видео» → заявка
    modal.querySelectorAll<HTMLButtonElement>("[data-modal-cta]").forEach((btn) => btn.addEventListener("click", () => {
      const k = btn.dataset.modalCta!;
      const code = selected;
      closeModal();
      setTimeout(() => { if (k === "smeta") openQuiz("smeta", code); else openRequest(k); }, reduce ? 0 : 320);
    }));
    // «Получить расчёт» по всему каталогу → квиз комплектации
    root.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("[data-calc]")) openQuiz("complectation"); });
    // CTA внутри карточки: «получить полную комплектацию» → квиз; «поменять планировку» → заявка
    modal.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-stage-cta]")) { const code = selected; closeModal(); setTimeout(() => openQuiz("complectation", code), reduce ? 0 : 320); }
      else if (t.closest("[data-plan-change]")) { closeModal(); setTimeout(() => openRequest("layout"), reduce ? 0 : 320); }
    });

    const init = () => { const a = tabs.find((t) => t.getAttribute("aria-selected") === "true"); if (a) moveIndicator(a); };
    window.addEventListener("load", init); window.addEventListener("resize", init); init();
    // Инициализация вариантов
    if (isShowcase || isCoverflow || isCollection) { buildList(data.groups[0].id); selectProject(selected); }
    if (isSpread) { buildList(data.groups[0].id); selected = codesNow[0]; }
    if (isTable) { buildList(data.groups[0].id); selectProject(selected); tableFit?.(); }
  }
</script>
