    const videoReal = modal.querySelector<HTMLElement>("[data-modal-video-real]")!;
    const videoStub = modal.querySelector<HTMLElement>("[data-modal-video-stub]")!;
    const videoPoster = modal.querySelector<HTMLImageElement>("[data-modal-video-poster]")!;
