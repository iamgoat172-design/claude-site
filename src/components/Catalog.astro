    const thumbCard = (p: P, active: boolean) => `<button type="button" data-select="${p.code}" role="option" aria-selected="${active}" class="group relative aspect-[4/3] w-40 shrink-0 overflow-hidden rounded-2xl border text-left transition-all duration-300 aria-selected:border-accent/70 border-white/10 hover:border-white/30 sm:w-48">
